# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# raw downloaded source data (rebuilt by scripts/, never committed)
data/raw/

# generated dictionary shards (~50MB; rebuilt by `npm run data:dict`)
public/data/dict/

# generated full-corpus search index (rebuilt by `npm run data:search` from the committed books)
public/data/search/
public/data/search.json

# env
.env
.env.*
!.env.example

# agent scratch space: the only place for throwaway files, never committed (see docs/handbook.md)
tmp/

# local mirror of the R2 asset bucket (picture-book illustrations and narration, ~1.5 MB per book);
# written by scripts/fetch-storyweaver.ts, uploaded with `aws s3 sync` (see README), never committed
assets/

# misc
.DS_Store
*.log
*.tsbuildinfo
coverage/
.cursor/
.claude-flow/
.swarm/
ruvector.db
AGENTS.md
CLAUDE.md
docs/
# local placeholder stories for developing the audio player (synthetic clips, never shipped)
data/stories-src/_dev/
public/data/stories/_dev/

# generated stories manifest (rebuilt by `npm run data:stories`; may include local _dev clips)
public/data/stories/manifest.json

# recordings awaiting a recorded licence (GH #80): kept locally, never committed until then
public/data/stories/*.mp3
