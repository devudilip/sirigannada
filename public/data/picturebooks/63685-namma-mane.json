ed":"2026-09-25"},"pages":[{"n":1,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p01.jpg","width":708,"height":508},"text":["ನೀರು ಎರಚುವುದು ಯಾರಿಗಿಷ್ಟ?"]},{"n":2,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p02.jpg","width":639,"height":689},"text":["ಚಿಲಿಕಾ ಸರೋವರದಲ್ಲಿನ ಇರ್ರವಾಡಿ ಡಾಲ್ಫಿನ್ ಗಳಿಗೆ."]},{"n":3,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p03.jpg","width":708,"height":507},"text":["ಧೂಳಿನ ಸ್ನಾನ ಯಾರಿಗಿಷ್ಟ?"]},{"n":4,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p04.jpg","width":708,"height":507},"text":["ದಾಂಡೇಲಿ ಕಾಡಲ್ಲಿರುವ","ದಾಸ ಮಂಗಟ್ಟೆ ಹಕ್ಕಿಗಳಿಗೆ."]},{"n":5,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p05.jpg","width":708,"height":507},"text":["ಒದ್ದೆ ಮಣ್ಣಲ್ಲಿರುವುದು ಯಾರಿಗಿಷ್ಟ?"]},{"n":6,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p06.jpg","width":639,"height":689},"text":["ಕಾಜಿರಂಗ ನದಿ ತೀರದಲ್ಲಿನ ಖಡ್ಗಮೃಗಗಳಿಗೆ."]},{"n":7,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p07.jpg","width":708,"height":507},"text":["ಸಗಣಿ ಗುಡ್ಡೆ ಮಾಡುವುದು ಯಾರಿಗಿಷ್ಟ?"]},{"n":8,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p08.jpg","width":708,"height":507},"text":["ಹಿಮಾಲಯದ ತಪ್ಪಲಿನ ನೀಲ್ ಗಾಯ್ ಗಳಿಗೆ."]},{"n":9,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p09.jpg","width":708,"height":507},"text":["ಬಿಲಗಳಲ್ಲೇ ಇರುವುದು ಯಾರಿಗಿಷ್ಟ?"]},{"n":10,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p10.jpg","width":708,"height":507},"text":["ಗಿರ್ ಕಾಡಿನ ಒಣಪ್ರದೇಶದ","ದಪ್ಪ ಬಾಲದ ಪ್ಯಾಂಗೋಲಿನ್‍ ಗಳಿಗೆ."]},{"n":11,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p11.jpg","width":708,"height":507},"text":["ಮರದಿಂದ ಮರಕ್ಕೆ ಹಾರುವುದು ಯಾರಿಗಿಷ್ಟ?"]},{"n":12,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p12.jpg","width":639,"height":687},"text":["ನಂದಫಾ ಕಾಡಿನ ಹಳದಿ ಗಂಟಲ ಮಾರ್ಟಿನ್ ಗೆ."]},{"n":13,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p13.jpg","width":708,"height":507},"text":["ಸಣ್ಣ ಹುಲ್ಲುಗಾವಲಿನಲ್ಲಿ ಕಣ್ಣಾಮುಚ್ಚಾಲೆ ಯಾರಿಗಿಷ್ಟ?"]},{"n":14,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p14.jpg","width":708,"height":507},"text":["ಜೈಸಲ್ಮೇರಿನ ಸಣ್ಣ ಹುಲ್ಲುಗಾವಲಿನಲ್ಲಿ","ಬಂಗಾಳ ನರಿಗಳಿಗೆ."]},{"n":15,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p15.jpg","width":3351,"height":2406},"text":["ಸಂಗಾತಿಗಳ ಜೊತೆ ಗೂಡು ಕಟ್ಟಿಕೊಳ್ಳುವುದು ಯಾರಿಗಿಷ್ಟ?"]},{"n":16,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p16.jpg","width":639,"height":689},"text":["ಆಟಪಾಕ ಪಕ್ಷಿಧಾಮದ ಚುಕ್ಕೆ ಕೊಕ್ಕಿನ ಹೆಜ್ಜಾರ್ಲೆಗಳಿಗೆ."]},{"n":17,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p17.jpg","width":708,"height":507},"text":["ಮನೆಯಲ್ಲಿ ಆರಾಮವಾಗಿರುವುದು ಯಾರಿಗಿಷ್ಟ?"]},{"n":18,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p18.jpg","width":3351,"height":1803},"text":["ನಮ್ಮೆಲ್ಲರಿಗೂ!"]},{"n":19,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p19.jpg","width":708,"height":507},"text":["1","2","3","4","5","6","7","8","1 . ನೀಲ್ ಗಾಯ್‍: ಹಿಮಾಚಲ ಪ್ರದೇಶ, ಹಿಮಾಲಯ ಬೆಟ್ಟಗಳ ಸಮೀಪ","2. ಬಂಗಾಳ ನರಿ : ಜೈಸಲ್ಮೇರ್, ರಾಜಸ್ಥಾನ","3. ಖಡ್ಗಮೃಗ : ಕಾಜಿರಂಗ ರಾಷ್ಟ್ರೀಯ ಉದ್ಯಾನ, ಅಸ್ಸಾಂ","4. ಹಳದಿ ಗಂಟಲಿನ ಮಾರ್ಟಿನ್‍ : ನಂದಫಾ ರಾಷ್ಟ್ರೀಯ ಉದ್ಯಾನ, ಅರುಣಾಚಲ ಪ್ರದೇಶ","5. ಇರ್ರವಾಡಿ ಡಾಲ್ಫಿನ್‍: ಚಿಲಿಕಾ ಸರೋವರ, ಒರಿಸ್ಸಾ","6. ಚುಕ್ಕೆ ಕೊಕ್ಕಿನ ಹೆಜ್ಜಾರ್ಲೆ: ಆಟಪಾಕ ಪಕ್ಷಿಧಾಮ, ಆಂಧ್ರಪ್ರದೇಶ","7. ದಾಸ ಮಂಗಟ್ಟೆ ಹಕ್ಕಿ: ದಾಂಡೇಲಿ ವನ್ಯಜೀವಿಧಾಮ, ಕರ್ನಾಟಕ","8. ಪ್ಯಾಂಗೊಲಿನ್‍: ಗಿರ್‍ ಕಾಡು, ಗುಜರಾತ್‍","ಭಾರತದ ಎಲ್ಲೆಲ್ಲಿ ಈ ಕೆಳಗೆ ಹೆಸರಿಸಿರುವ ಪ್ರಾಣಿ-ಪಕ್ಷಿಗಳನ್ನು ಕಾಣಬಹುದು?"]},{"n":20,"image":{"src":"https://assets.sirigannada.in/picturebooks/63685-namma-mane/p20.jpg","width":3351,"height":2406},"text":[]}],"wordCount":147}