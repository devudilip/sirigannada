      },
      "text": [
        "ನನ್ನ ಖಾಲಿ ಬೂಟಲ್ಲಿ ಈಗೊಂದು ಬೆಣಚುಕಲ್ಲು,",
        "ಪಕ್ಕದ ಬೀದಿಗೆ ಕೇಳಲು ಹೋಗಿದ್ದೆ ಢಂಗುರದ ಸದ್ದು,",
        "ಆಗಲೇ ಸೇರಿತೇನೋ ದಿಬಿ ದಿಬಿ ಇದು?"
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/59998-bootallondu-benachukallu/p03.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಇಲ್ಲ, ಆಕಾಶದಿಂದ ಏನಾದರೂ ಬಿತ್ತಾ?",
        "ಯಾವುದೋ ಮೋಡವೋ, ಹಕ್ಕಿನೋ…",
        "ದೊಡ್ಡ ಕಣ್ಣು, ಡುಮ್ಮ ಹೊಟ್ಟೆಯ ಗುಮ್ಮ",
        "ಏನಾದರೂ ಎಸೆದನೇ?"
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/59998-bootallondu-benachukallu/p04.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ನನ್ನ ಖಾಲಿ ಬೂಟಲ್ಲಿ ಬೆಣಚುಕಲ್ಲು,",
        "ಅದೇನು, ಆ ಪಾರ್ಕ್ ನಿಂದ ಬಂತೇ?",
        "ಹಾಂ, ನನ್ನ ಗೆಳೆಯ ವಂಡರಗಪ್ಪೆಯೇ ಹಾಕಿತೇನೋ?",
        "ಟರ್! ಟರ್! ಟರ್!"
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/59998-bootallondu-benachukallu/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಥವಾ ಹಾರು ಜಮಖಾನೆಯಿಂದ ಇಳಿಯಿತೇ?",
        "ಅದೇ ನಾನು ಎಂದೋ ಕೇಳಿದ್ದ ಕತೆಯಿಂದ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/59998-bootallondu-benachukallu/p06.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಚುಕುಬುಕು ರೈಲಲ್ಲಿ ಬಂತೇ?",
        "ಅದೇ ದೂರದ ಲಾಹೋರಿನಿಂದ…",
        "ನನ್ನ ಖಾಲಿ ಬೂಟಲ್ಲಿ ಬೆಣಚುಕಲ್ಲು."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/59998-bootallondu-benachukallu/p07.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಅಥವಾ ಈಜುತ್ತಾ ಬಂತೇ?",
        "ಸಮುದ್ರ ರಾಕ್ಷಸನ ಜತೆಗೆ…"
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/59998-bootallondu-benachukallu/p08.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ನನ್ನ ಖಾಲಿ ಬೂಟಲ್ಲಿ ಬೆಣಚುಕಲ್ಲು.",
        "ಮೀನು ಲಾರಿ ಏರಿ ಇಲ್ಲಿಗೆ ಬಂತೇ?",
        "ಹಸಿದ ಕಾ! ಕಾ! ಕಾ! ಕಾಗೆಗಳ ಕಣ್ಣು ತಪ್ಪಿಸಿ."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/59998-bootallondu-benachukallu/p09.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಲೈಬ್ರರಿಯಿಂದ ಬಂತೆ?",
        "ನಾನು ಪುಸ್ತಕ ತರಲು ಹೋದಾಗ?"
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/59998-bootallondu-benachukallu/p10.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನನ್ನ ಖಾಲಿ ಬೂಟಲ್ಲಿ ಬೆಣಚುಕಲ್ಲು.",
        "ನೆನ್ನೆವರೆಗೂ ಇರಲಿಲ್ಲ ಅದರಲ್ಲೇನೂ… ಅರೆ!",
        "ಇದು ಎಲ್ಲಿಂದ ಬಂದಿರಬಹುದು?",
