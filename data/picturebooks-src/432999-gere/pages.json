        "width": 708,
        "height": 508
      },
      "text": [
        "ಹಸಿರು ಹುಲ್ಲಿನಲ್ಲಿ ಮತ್ತು ಬಣ್ಣದ ಗರಿಗಳಲ್ಲಿ."
      ]
    },
    {
      "n": 4,
      "image": {
