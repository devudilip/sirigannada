      "n": 2,
      "image": {
        "src": "/data/picturebooks/432999-gere/p02.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಎಲ್ಲ ಕಡೆ ಗೆರೆಗಳಿವೆ. ಆ ಎಲೆಗಳನ್ನ ನೋಡು."
      ]
