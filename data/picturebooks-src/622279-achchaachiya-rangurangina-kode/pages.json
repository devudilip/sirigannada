{
  "pages": [
    {
      "n": 1,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p01.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಮತ್ತೆ ಕೊಡೆ ಕಳ್ಕೊಂಡೆಯ?” ಕೇಳಿದರು ಅಚ್ಛಾಚಿ.",
        "“ಅದೇನ್ ಗೊತ್ತಾ ಅಚ್ಛಾಚಿ,",
        "ಈ ಸಲ ಕೊಡೆ ಕಳ್ಕೋಬಾರದು ಅಂತ ತುಂಬಾ ಹುಷಾರಾಗಿದ್ದೆ. ಬಸ್ಸಿನಲ್ಲಿ ಬಿಟ್ಟೆ ಅಂತ ಕಾಣತ್ತೆ,” ಎನ್ನುವಾಗ ಸಹ್ಯಾದ್ರಿಗೆ ಅಳು",
        "ಬಂದ ಹಾಗಾಯಿತು."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p02.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "“ಪ್ಲೀಜ್... ಅಮ್ಮನಿಗೆ ಹೇಳಬೇಡಿ! ಆದ್ರೆ, ಈಗ ನನಗೊಂದು ಕೊಡೆ ಬೇಕಲ್ಲ,” ಕೇಳಿದಳು ಸಹ್ಯಾದ್ರಿ.",
        "“ಸರಿ. ಇದನ್ನೇನು ನಾವು ಅಮ್ಮಂಗೆ ಹೇಳಬೇಕಾಗಿಲ್ಲ.",
        "ಹೊಸ ಕೊಡೆಯೊಂದನ್ನ ಮಾಡಕ್ಕಾಗತ್ತಾ",
        "ನೋಡೋಣ,” ಎಂದರು ಅಚ್ಛಾಚಿ."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p03.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಸಲಕರಣೆಗಳ ಡಬ್ಬಿ ತಡಕಾಡುತ್ತ ಅಚ್ಛಾಚಿ, “ಹೊಸ ಕೊಡೆ ತಯಾರಿಸಲು ಬೇಕಾದ ಎಲ್ಲ ಸಾಮಾನುಗಳೂ ನಮ್ಮ ಹತ್ರ ಇವೆ,” ಎಂದರು.",
        "“ಕೊಡೆಗೆ ಬೇಕಾದಷ್ಟು ಬಟ್ಟೆ ಎಲ್ಲಿಂದ ತರೋದು?” ಸಹ್ಯಾದ್ರಿಯ ಪ್ರಶ್ನೆ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p04.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "“ಆ ಪೆಟ್ಟಿಗೆಯೊಳಗಿಂದ ನಿನಗೆ ಇಷ್ಟವಾದ ಬಣ್ಣ ಆರಿಸು.”",
        "“ಓಹ್... ಎಷ್ಟ್ ಚೆನ್ನಾಗಿದೆ ಈ ಬಣ್ಣ!”"
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಆದರೆ, ಇದು ಒಂದು ಕೊಡೆಗೆ ಸಾಕಾಗುವುದಿಲ್ಲ,” ಎಂದರು ಅಚ್ಛಾಚಿ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p06.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಹೌದು. ಆದರೆ, ನಾವು ಈ ಎಲ್ಲ",
        "ಬಣ್ಣದ ಬಟ್ಟೆಗಳನ್ನ ಸೇರಿಸಿ ಕೊಡೆಯೊಂದನ್ನ ಮಾಡಬಹುದು,” ಎಂದು ಯೋಚಿಸಿದಳು ಸಹ್ಯಾದ್ರಿ."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p07.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಆ ಕೆಂಪು ಇರ್ಲಿ ಅಲ್ವ? ಇದರೊಂದಿಗೆ ಸ್ವಲ್ಪ ಹಳದಿ ಸೇರಿದರೆ ಸೂರ್ಯಾಸ್ತದಂತೆ ಕಾಣಿಸತ್ತೆ,” ಕೇಳಿದರು ಅಚ್ಛಾಚಿ.",
        "“ಇದನ್ನ ನೋಡಿ! ಈ ನೇರಳೆ ಬಣ್ಣ ಎಷ್ಟು ಚೆನ್ನಾಗಿದೆ,” ಎಂದಳು ಸಹ್ಯಾದ್ರಿ."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಇನ್ನಷ್ಟು ಬಣ್ಣಗಳನ್ನ ಸೇರಿಸೋಣ!”",
        "ಎಂದಳು ಸಹ್ಯಾದ್ರಿ.",
        "“ಮ್... ಇನ್ನೂ ಸ್ವಲ್ಪ ಬಣ್ಣ ಬೇಕನ್ನಿಸುತ್ತೆ,” ಎಂದಳು ಸಹ್ಯಾದ್ರಿ.",
        "“ಕೆಂಪು ಅರ್ಧ-ವೃತ್ತವು ಚೆಂದ ಕಾಣ್ತಿದೆ.”",
        "“ಚೂರು ಹಸಿರು ಸೇರಿಸಿದರೆ ಹೇಗಿರಬಹು?”"
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p09.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಸ್ವಲ್ಪ ಗುಲಾಬಿ ಸೇರಿಸಿ ನೋಡೋಣ.”",
        "“ಸ್ವಲ್ಪ ಕಿತ್ತಳೆ.”",
        "“ಹಾಗೇ ಸ್ವಲ್ಪ ಕುಂಕುಮದ ಬಣ್ಣ.”"
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p10.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಕೊನೆಯದಾಗಿ, ಅಚ್ಛಾಚಿ ಮತ್ತು ಸಹ್ಯಾದ್ರಿ ಕೆಲವು ಬಣ್ಣಗಳನ್ನ;",
        "ಸೇರಿಸಿದರು, ತೆಗೆದರು, ಮತ್ತೆ ಸೇರಿಸಿದರು. ಎಲ್ಲ ಅಚ್ಚುಕಟ್ಟಾಯಿತು.",
        "ಅಳೆದು, ಕತ್ತರಿಸಿ, ಹೊಲಿಗೆ ಹಾಕಲು ಅಚ್ಛಾಚಿ ರಾತ್ರಿಯಿಡೀ ಎಚ್ಚರವಾಗಿದ್ದರು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p11.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಮರುದಿನ ಬೆಳಗ್ಗೆ ಶಾಲೆಗೆ ಹೋಗುವ ಸಮಯಕ್ಕೆ ಕೊಡೆ ರೆಡಿ!",
        "ದಾರಿಯಲ್ಲಿ ಮಳೆ ಶುರುವಾಯಿತು. ಅಚ್ಛಾಚಿ ತನ್ನ ಬ್ಯಾಗಿನಲ್ಲಿಟ್ಟಿದ್ದ ಕೊಡೆಯನ್ನು ಬೇಗ ಹೊರತೆಗೆದಳು ಸಹ್ಯಾದ್ರಿ."
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p12.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಜುಂಯ್ಯ್ ಪಟ್!"
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p13.jpg",
        "width": 708,
        "height": 508
      },
      "text": []
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/622279-achchaachiya-rangurangina-kode/p14.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಸಹ್ಯಾದ್ರಿಯ ಪೈ ನಕ್ಷೆ",
        "ಕೊಡೆಯಲ್ಲಿರುವ ಬಟ್ಟೆಯ ತುಂಡುಗಳೆಲ್ಲ ಸೇರಿ ಒಂದು ವೃತ್ತವನ್ನು ರಚಿಸಿವೆ. ಪೈ ನಕ್ಷೆ ಒಂದು ವೃತ್ತಾಕಾರದ ರೇಖಾಚಿತ್ರವಾಗಿದೆ. ಡೇಟಾವನ್ನು ಪ್ರತಿನಿಧಿಸಲು ಇದನ್ನು ಬಳಸಲಾಗುತ್ತದೆ. ನಕ್ಷೆಗಳು ಸಂಖ್ಯೆಗಳಿಗಿಂತ ವೇಗವಾಗಿ ಮತ್ತು ಸರಳವಾದ ಭಾಷೆಯಲ್ಲಿ ಡೇಟಾವನ್ನು ವಿವರಿಸುತ್ತವೆ. ಪೈ ನಕ್ಷೆಯನ್ನು ಸಣ್ಣ ಭಾಗಗಳಾಗಿ ವಿಂಗಡಿಸಲಾಗಿದೆ ಇದರ ಎಲ್ಲ ಭಾಗಗಳು ಒಂದು ದೊಡ್ಡ ಘಟಕವನ್ನು ಪ್ರತಿನಿಧಿಸಬಹುದು.",
        "ಸಹ್ಯಾದ್ರಿ ಕೊಡೆಯಲ್ಲಿ ಎಲ್ಲ ಬಣ್ಣಗಳನ್ನು ಸಮಾನವಾಗಿ ಬಳಸಲಾಗಿದೆ."
      ]
    }
  ]
}