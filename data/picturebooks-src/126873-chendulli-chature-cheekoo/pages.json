    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/126873-chendulli-chature-cheekoo/p02.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಚೀಕೂ ತೆಳ್ಳಗು ಅಲ್ಲ, ಗುಂಡಗು ಅಲ್ಲ ಎತ್ತರವಲ್ಲ, ಕುಳ್ಳಿಯು ಅಲ್ಲ."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/126873-chendulli-chature-cheekoo/p03.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಹೆಚ್ಚು ಮಾತಿಲ್ಲ ಕುಣಿಯಲ್ಲ, ಜಿಗಿಯಲ್ಲ, ವೇಗವಾಗಿ ಓಡಲ್ಲ ಬಹುಶಃ ಕತೆಗಳನ್ನು ಹೆಣೆಯುತ್ತಾಳೆ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/126873-chendulli-chature-cheekoo/p04.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಅವಳು, ಕೆರೆಯಲ್ಲಿ ಈಜಲ್ಲ ಮಾವಿನ ತೋಪಲ್ಲಿ ತಿರುಗಲ್ಲ, ಕಡಲೆಕಾಯಿ ಸುಲಿಯಲ್ಲ ಸಂತೆಯ ದಾರೀಲು ಸಿಕ್ಕಲ್ಲ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/126873-chendulli-chature-cheekoo/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಒಂದಿನ ಬೀಸಿತು ಜೋರು ಗಾಳಿ ಕರೆಂಟು ಹೋಯ್ತು, ಕತ್ತಲು ಕಂಕಾಳಿ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/126873-chendulli-chature-cheekoo/p06.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಒಬ್ಬರ ನೆರಳು ಒಬ್ಬರು ನೋಡಿ ತುಂಬಾ ತುಂಬಾ ಹೆದರಿದರು. ಕತ್ತಲೆಗಂಜಿ ಗಡಗಡ ನಡುಗಿದರು."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/126873-chendulli-chature-cheekoo/p07.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಚೀಕೂ ಪುಟ್ಟಿ ತುಂಬಾ ಗಟ್ಟಿ ಫಕ್ಕನೆ ಲಾಟೀನು ಹಚ್ಚಿದಳು, ಕತ್ತಲೆ ದೂರಕೆ ದೂಡಿದಳು."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/126873-chendulli-chature-cheekoo/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಬಗೆ ಬಗೆ ಕಥೆಗಳ ಹೇಳಿದಳು ಎಲ್ಲರ ಜೊತೆಗೂಡಿ ಹಾಡಿದಳು. ಎಲ್ಲರಲಿ ಧೈರ್ಯ ತುಂಬಿದಳು."
      ]
    }
  ]
}