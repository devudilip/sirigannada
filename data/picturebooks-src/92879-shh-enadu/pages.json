{
  "pages": [
    {
      "n": 1,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p01.jpg",
        "width": 708,
        "height": 763
      },
      "text": [
        "“ಮಲ್ಕೋ ದಿಯಾ. ಮಲ್ಕೋ ತಾರಾ!” ಎನ್ನುತ್ತ ಅಪ್ಪ ಲೈಟ್ ಆರಿಸಿದರು."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p02.jpg",
        "width": 708,
        "height": 761
      },
      "text": [
        "ರಪ್ ರಪ್! ಪಟ ಪಟ!",
        "ಏನದು? ತಾರಾ ಮತ್ತು ದಿಯಾ ಮುಖ-ಮುಖ ನೋಡಿಕೊಂಡರು."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p03.jpg",
        "width": 639,
        "height": 687
      },
      "text": [
        "“ದೆವ್ವ!” ದಿಯಾ ಮತ್ತು ತಾರಾ ಹೊದಿಕೆಯೊಳಗೆ ಅವಿತುಕೊಂಡರು.",
        "“ಅಯ್ಯೋ ಈಗೇನು ಮಾಡುವುದು?” ಎಂದಳು ದಿಯಾ.",
        "ಟಪ್ ಟಪ್! ಉಫ್!"
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p04.jpg",
        "width": 639,
        "height": 687
      },
      "text": [
        "“ನಾವೇ ಅದನ್ನು ಹೆದರಿಸಿ ಓಡಿಸೋಣವಾ,” ಎಂದಳು ತಾರಾ.",
        "“ನಾವೇ ಒಂದು ದೆವ್ವವನ್ನು ಮಾಡೋಣ ಇರು,” ಎಂದಳು ದಿಯಾ.",
        "“ಮಫ್ಲರ್ ದೆವ್ವ! ದೆವ್ವಕ್ಕೆ ಕುಂಬಳಕಾಯಿ ತಲೆ.”"
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p05.jpg",
        "width": 639,
        "height": 687
      },
      "text": [
        "“ನೋಡಿದೆಯ ಅದು ಹೆದರಿಕೊಂಡೆ ಬಿಡ್ತು,” ಎಂದಳು ತಾರಾ.",
        "“ಅಯ್ಯೋ ಇಲ್ವೇ, ಅದು ಎದ್ದು ನಿಲ್ಲುತ್ತಿದೆ!” ಎಂದು ದಿಯಾ ಅಡಗಿದಳು.",
        "ಅಯ್ಯೋ! ಅಯ್ಯಯ್ಯೋ!"
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p06.jpg",
        "width": 639,
        "height": 687
      },
      "text": [
        "“ಬೇಗ ನಿನ್ನ ಹೊದಿಕೆ ಎತ್ತಿಕೊ. ಹಾಗೆ ನಾವು ಹೊದಿಕೆಯ ಡೈನೊಸಾರ್ ಮಾಡೋಣವಾ?” ಎಂದಳು ದಿಯಾ.",
        "“ಟಾರ್ಚ್ ಎಲ್ಲಿದೆ?” ಕೇಳಿದಳು ತಾರಾ.",
        "ದಿಯಾ ಬೀದಿ ದೀಪದ ಕಡೆಗೆ ಕೈ ತೋರಿಸಿದಳು.",
        "ಸರಸರ! ಸರ್!"
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p07.jpg",
        "width": 639,
        "height": 687
      },
      "text": [
        "“ನೋಡು ನಾನೀಗ ರೇನ್ ಕೋಟ್ ಮತ್ತು ಟಾರ್ಚಿನಿಂದ ಕುರ್ಚಿ ದೆವ್ವ ಮಾಡ್ತೀನಿ,” ಎಂದಳು ದಿಯಾ.",
        "“ಎರಡೂ ದೆವ್ವಗಳು ಹೆದರಿ ಓಡಿ ಹೋಗಬೇಕು,” ಎಂದಳು ತಾರಾ. “ಟಾರ್ಚ್ ಇನ್ನೂ ಹತ್ತಿರ ಇಡು. ಕುರ್ಚಿ ದೆವ್ವವನ್ನು ದೊಡ್ಡದಾಗಿ ಮಾಡೋಣ!”",
        "ಢಂ ಢಮಾರ್!"
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p08.jpg",
        "width": 639,
        "height": 687
      },
      "text": [
        "ತಾರಾ ತನ್ನ ಕೈಯನ್ನು ಹೊದಿಕೆಯ ಒಳಗೆ ಸರಬರ ಎಂದು ಅಲ್ಲಾಡಿಸಿದಳು.",
        "ಕರಕ್! ಕರಕ್!"
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p09.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "“ನೀವು ಇನ್ನೂ ಮಲಗಿಲ್ಲವೇ?” ಕೇಳಿದರು ಅಪ್ಪ.",
        "“ಅಯ್ಯೋ, ಅಪ್ಪಾ ನೀವೇನಾ ದೆವ್ವ?” ತಾರಾ ಮತ್ತು ದಿಯಾ ಕಿರಿಚಿಕೊಂಡರು.",
        "“ಆಂ, ದೆವ್ವವೇ?”",
        "ಮಿಣ್! ಮಿಣಕ್!"
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p10.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಹ್ಹ ಹ್ಹ! ಹಾ ಹ್ಹ ಹ್ಹ!",
        "ಅವರೆಲ್ಲ ನಕ್ಕು ನೆರಳಿನ ದೆವ್ವಗಳಂತೆ ಅನುಕರಣೆ ಮಾಡಿದರು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/92879-shh-enadu/p11.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ನೆರಳು ನೋಡೋಣ ಬನ್ನಿ",
        "ಯಾವುದಾದರೂ ಒಂದು ವಸ್ತುವಿನ ಮೇಲೆ ಬೆಳಕು ಬಿದ್ದಾಗ ಅದರ ಹಿಂದೆ ಅದರದ್ದೇ ಕಪ್ಪು ಆಕಾರ ಮೂಡುತ್ತದೆ. ಇದನ್ನೇ ನೆರಳು ಎನ್ನುವರು.",
        "ನೆರಳು ಬೆಳಕಿನ ಆಧಾರದ ಮೇಲೆ ಬದಲಾಗುವುದು. ಬೆಳಕು ವಸ್ತುವಿನ ಹತ್ತಿರ ಇರುವಾಗ ನೆರಳು ದೊಡ್ಡದಾಗುತ್ತದೆ. ಒಂದು ವೇಳೆ ಬೆಳಕು ವಸ್ತುವಿನಿಂದ ದೂರದಲ್ಲಿದ್ದರೆ ನೆರಳು ಚಿಕ್ಕದಾಗಿ ಕಾಣುವುದು.",
        "ಎರಡಕ್ಕಿಂತ ಹೆಚ್ಚು ಬೆಳಕು ಅದರ ಮೇಲೆ ಬಿದ್ದಾಗ ಅದೇ ವಸ್ತುವಿನ ನೆರಳು ಎರಡೆರಡಾಗಿಯೂ ಕಾಣುತ್ತದೆ! ನೀರು ತುಂಬಿದ ಗ್ಲಾಸಿನ ಮೇಲೆ ಟಾರ್ಚ್ ಬೆಳಕು ಬಿಟ್ಟು ನೋಡಿ. ಇದೇ ರೀತಿ ಒಂದು ಪುಸ್ತಕವೋ ಅಥವಾ ಒಂದು ಜಾಲರಿಯ ಮೇಲೋ ಬೆಳಕು ಹಾಯಿಸಿ ನೆರಳುಗಳು ಆಚೀಚೆ ಆಗುವುದನ್ನು ಗಮನಿಸಿ."
      ]
    }
  ]
}