    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/455644-ellelloo-gida-mara-balligalu/p04.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಏರುವ ಬಳ್ಳಿಗಳು.",
        "ಸೌತೆಕಾಯಿ, ದ್ರಾಕ್ಷಿ ಬಳ್ಳಿಗಳು ಕಂಬ, ಕೊಂಬೆಗಳಿಗೆ ಒರಗಿಕೊಂಡು ಮೇಲೆ ಏರುತ್ತವೆ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/455644-ellelloo-gida-mara-balligalu/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಹಬ್ಬುವ ಬಳ್ಳಿಗಳು.",
        "ಕುಂಬಳಕಾಯಿ, ಕಲ್ಲಂಗಡಿ ಬಳ್ಳಿಗಳು",
        "ನೆಲದ ಉದ್ದಕ್ಕೂ ಹಬ್ಬುತ್ತವೆ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/455644-ellelloo-gida-mara-balligalu/p06.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನೀರಿನಲ್ಲಿ ಬೆಳೆಯುವ ಸಸ್ಯಗಳು.",
        "ನೀರನೈದಿಲೆ, ತಾವರೆಗಳು ಕೆರೆ-ಕೊಳಗಳ ಮೇಲೆ ತೇಲುತ್ತವೆ."
      ]
    },
    {
