        "width": 708,
        "height": 508
      },
      "text": [
        "ತೀವ್ರ ಚಳಿಯಲ್ಲಿಯೂ ಅರಳುವ ಸಸ್ಯಗಳು."
      ]
    },
    {
      "n": 9,
      "image": {
