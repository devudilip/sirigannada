{
  "pages": [
    {
      "n": 1,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p01.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ಮಾವಿನ ಮರದಲ್ಲಿ ವಾಸಿಸುತ್ತೇನೆ. ಬೇಸಿಗೆಯಲ್ಲಿ ನಾನು ರುಚಿಯಾದ ಮಾವಿನ ಹಣ್ಣುಗಳನ್ನು ತಿನ್ನುತ್ತೇನೆ."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p02.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನನ್ನ ಮರಿಗಳು ಗೂಡಿನಲ್ಲಿದ್ದಾಗ, ನಾನು ಬಹಳ ಜಾಗ್ರತೆ ವಹಿಸಬೇಕು."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p03.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಬನ್ನಿ, ನನ್ನ ಗೂಡಿನೊಳಗೆ ಇಣುಕಿ, ಅಲ್ಲಿ ಎಷ್ಟು ಚೆಂದ ಚೆಂದದ ವಸ್ತುಗಳಿವೆ ಎಂದು ನೋಡಿ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p04.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನನಗೆ ವಿಮಾನದಂತೆ ಆಕಾಶದ ಎತ್ತರಕ್ಕೆ ಹಾರಲು ಇಷ್ಟ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p05.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ಮರದ ಮೇಲೆ ಕುಳಿತು, ಅತ್ತಿತ್ತ ರುಚಿಯಾದ ತಿಂಡಿ ತುಣುಕು ಇದೆಯೇ ಎಂದು ಹುಡುಕುತ್ತೇನೆ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p06.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ಒಮ್ಮೆ ನನ್ನ ಬಲಕ್ಕೆ ನೋಡುತ್ತೇನೆ. ಒಮ್ಮೆ ಎಡಕ್ಕೆ ನೋಡುತ್ತೇನೆ."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p07.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನನಗೆ ಮೀನೆಂದರೆ ತುಂಬ ಇಷ್ಟ. ಮೀನು ನನ್ನ ಕಣ್ಣಿಗೆ ಕಂಡರೆ ಸಾಕು, ಎತ್ತಿಕೊಳ್ಳಲು ಸುಂಯ್ ಎಂದು ಕೆಳಗೆ ಬರುತ್ತೇನೆ."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p08.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "‘ಕಾಗೆ ಒಂದಗುಳ ಕಂಡೊಡೆ ಕರೆಯದೆ ತನ್ನ ಬಳಗವನು,’ಎನ್ನುವ ಮಾತನ್ನು ನೀವು ಕೇಳಿಯೇ ಇರುತ್ತೀರಿ. ನಾನೂ ಕೂಡ ಗೆಳೆಯರನ್ನು ಕರೆದು ಹಬ್ಬದೂಟವನ್ನು ಹಂಚಿಕೊಳ್ಳುತ್ತೇನೆ."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p09.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಕೆಲವರು ನನ್ನನ್ನು ನೋಡಿ, “ಶೂ! ಹೋಗು ಇಲ್ಲಿಂದ. ಎಷ್ಟು ಗಲಾಟೆ ಮಾಡುವೆ!” ಎಂದು ಬೈಯುತ್ತಾರೆ."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p10.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಆದರೆ ನರಿಯಣ್ಣನಿಗೆ ನಾನು ಹಾಡುವುದೆಂದರೆ ಬಹಳ ಇಷ್ಟ. ಹಾಗೆಂದು ನರಿಯಣ್ಣನೇ ಹೇಳಿತು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p11.jpg",
        "width": 479,
        "height": 689
      },
      "text": [
        "ಬನ್ನಿ ಕೆಲ ಹೊಸ ಪದಗಳನ್ನು ಕಲಿಯೋಣ. ಪ್ರಾಣಿ ಅಥವಾ ಪಕ್ಷಿಗಳು ಮಾಡುವ ಶಬ್ದಗಳಿಗೆ ಕೆಲವು ವಿಶೇಷ ಹೆಸರುಗಳಿವೆ. ಇವುಗಳಲ್ಲಿ ಎಷ್ಟು ನಿಮಗೆ ಗೊತ್ತು?",
        "ಕಾಗೆಯು ಕಾವ್ ಕಾವ್ ಎನ್ನುತ್ತದೆ.",
        "ಬೆಕ್ಕು ಮಿಯಾಂವ್ ಎನ್ನುತ್ತದೆ."
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/91441-galaateya-kaagegalu/p12.jpg",
        "width": 479,
        "height": 689
      },
      "text": [
        "ಸಿಂಹವು ಘರ್ಜಿಸುತ್ತದೆ.",
        "ನಾಯಿಯು ಬೊಗಳುತ್ತದೆ.",
        "ಕಾಗೆಗಳು ಕರ್ಕಶವಾಗಿ ಕೂಗಿ ಗಲಾಟೆ ಮಾಡುತ್ತವೆ, ಹಾಗಾಗಿಯೇ ಕೆಲವರು ಜೋರಾಗಿ ಮಾತಾಡುವಾಗ, “ಕಾಗೆಯ ಹಾಗೆ ಗಲಾಟೆ ಮಾಡುತ್ತಾನೆ,” ಎನ್ನುತ್ತಾರೆ."
      ]
    }
  ]
}