        "width": 708,
        "height": 508
      },
      "text": [
        "ಲಿನಿಯೊ ಮಲಗಿರುವ ಅಡ್ಡ ರೇಖೆ. ಬನ್ನಿ, ಇವರ ಒಂದಿಷ್ಟು ರೇಖಾ ಗೆಳೆಯರನ್ನು ಭೇಟಿಯಾಗೋಣ!"
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/66244-aakaara-matthu-liniyo-saahasa/p03.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ಈ ಸೊಟ್ಟ ರೇಖೆಗಳನ್ನು ನೋಡಿದಿರಾ?",
        "ಇವು ಅರ್ಧಚಂದ್ರ ಮತ್ತು ಡೊಂಕಪ್ಪ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/66244-aakaara-matthu-liniyo-saahasa/p04.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಇದು ಇಳಿಜಾರು!",
        "ಇದೊಂದು ಜಾರುಬಂಡೆಯ ಹಾಗೆ ವಾಲಿರುವ ರೇಖೆ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/66244-aakaara-matthu-liniyo-saahasa/p05.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ಈ ಗೆಳೆಯರು ಒಟ್ಟಾಗಿ ಈದಿನ ಏನು ಮಾಡುತ್ತಾರೆ?",
        "ಅವರೆಲ್ಲರೂ ಕೂಡಿ ಪ್ರಾಣಿಗಳ ಚಿತ್ರಗಳನ್ನು ಬಿಡಿಸುತ್ತಾರೆ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/66244-aakaara-matthu-liniyo-saahasa/p06.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಈ ನಾಯಿಯನ್ನು ನೋಡಿ! ಇದರಲ್ಲಿ ನಿಮಗೆ ಲಿನಿಯೊ ಎಲ್ಲಿದ್ದಾನೆಂದು ಕಂಡು ಹಿಡಿಯಲು ಆಯಿತೇ?"
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/66244-aakaara-matthu-liniyo-saahasa/p07.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ವಾಹ್, ಈ ಆನೆಯನ್ನು ನೋಡಿ! ಅರ್ಧಚಂದ್ರ, ಕಾಣಿಸುತ್ತಾನಾ?"
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/66244-aakaara-matthu-liniyo-saahasa/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಓಹೋ, ಇದೊಂದು ಆಮೆ!",
        "ನಿಮಗೆ ಡೊಂಕಪ್ಪನನ್ನು ಕಂಡು ಹಿಡಿಯಲು ಆಯಿತೇ?"
      ]
    },
