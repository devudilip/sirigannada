{
  "pages": [
    {
      "n": 1,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p01.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಊರ ನಡುವೆ, ಅನೇಕ ಮನೆ, ರಸ್ತೆಗಳ ನಡುವೆ ಫಾರೂಕಜ್ಜನ ತೋಟವಿದೆ."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p02.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಅಮೀರ್‌ನಿಗೆ ಎಲೆ, ಹೂವು, ಮರಗಳು ಎಂದರೆ ತುಂಬಾ ಇಷ್ಟ.",
        "ವಾರಕ್ಕೊಮ್ಮೆ ಅವನು ಫಾರೂಕಜ್ಜನನ್ನು ಭೇಟಿಯಾಗಲು ಹೋಗುತ್ತಾನೆ."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p03.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಹಾಗೆ ಹೋದಾಗಲೆಲ್ಲ ಗಿಡಗಳಿಗೆ ನೀರು ಹಾಕಲು ಸಹಾಯ ಮಾಡುತ್ತಾನೆ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p04.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಅವನು ಕಾಂಪೋಸ್ಟ್‌ ಗೊಬ್ಬರ ಮಾಡಲು ಸಹಾಯ ಮಾಡುತ್ತಾನೆ.",
        "ಇಡೀ ದಿನ ಅಜ್ಜನ ಜೊತೆ ಕೆಲಸ ಮಾಡುತ್ತಿರುತ್ತಾನೆ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಕೆಲಸ ಎಲ್ಲ ಮುಗಿದ ಮೇಲೆ, ಅಜ್ಜ-ಮೊಮ್ಮಗ",
        "ತೋಟದಲ್ಲಿ ಬೆಳೆದ ಹಣ್ಣಗಳನ್ನು ತಿನ್ನುತ್ತಾರೆ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p06.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಒಂದು ದಿನ, ಅಜ್ಜ ತನ್ನ ಮರಸೇಬು ಹಣ್ಣನ್ನು ತಿನ್ನಲಿಲ್ಲ.",
        "“ಯಾಕಜ್ಜ, ಏನಾಯಿತು?”",
        "ಕೇಳಿದ ಅಮೀರ್."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p07.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ನನ್ನ ತೋಟ ಇರಲ್ಲ ಇನ್ನು,” ಎಂದರು ಅಜ್ಜ.",
        "“ಯಾಕೆ?” ಎಂದು ಕೇಳಿದ ಅಮೀರ್."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p08.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "“ಹತ್ತಿರ ಹೋಗಿ ನೋಡು,” ಎಂದರು ಅಜ್ಜ.",
        "“ಯಾವುದೋ ಕೀಟಗಳು ಗಿಡಗಳನ್ನೆಲ್ಲ ತಿನ್ನುತ್ತಿವೆ.”"
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p09.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "“ಈಗ ಇಲ್ಲಿ ಜೀರುಂಡೆಗಳು (ಲೇಡಿಬರ್ಡ್ಸ್) ಇದ್ದಿದ್ದರೆ... ಗಿಡಗಳನ್ನು ಕೊಲ್ಲುವ ಕೀಟಗಳನ್ನು ತಿನ್ನುತ್ತಿದ್ದವು!",
        "ಅವಿಲ್ಲದೇ ತೋಟ ಉಳಿಯುವುದಿಲ್ಲ,” ಎಂದು ಪೇಚಾಡಿದರು ಅಜ್ಜ."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p10.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "“ಜೀರುಂಡೆಗಳು ತಾನೇ ಅಜ್ಜ...",
        "ನಾ ತರ್ತೀನಿ. ಎಷ್ಟ್ ಬೇಕು ಹೇಳಿ. ಒಂದು..? ಎರಡು..?” ಕೇಳಿದ ಅಮೀರ್."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p11.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಒಂದು ವಾರ ಪೂರ್ತಿ ಎಲ್ಲ ಕಡೆ ಹುಡುಕಿ, ಅಮೀರ್ ಜೀರುಂಡೆಗಳನ್ನು ಸಂಗ್ರಹಿಸಿದ."
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p12.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಅವನಿಗೆ ಆಟದ ಮೈದಾನದಲ್ಲಿ ಸಿಕ್ಕಿತು ಒಂದು ಜೀರುಂಡೆ."
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p13.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಅಂಗಡಿಯಲ್ಲಿ ಸಿಕ್ಕವು ಎರಡು."
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p14.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಪಾರ್ಕಿನಲ್ಲಿ ಸಿಕ್ಕವು ಮೂರು."
      ]
    },
    {
      "n": 15,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p15.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಟಿವಿ ಹಿಂದೆ ಸಿಕ್ಕವು ನಾಲ್ಕು."
      ]
    },
    {
      "n": 16,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p16.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಮುಂದಿನವಾರ ಅಮೀರ್ ಹತ್ತು ಜೀರುಂಡೆಗಳ ಜೊತೆ ಫಾರೂಕಜ್ಜನ ಮನೆ ಹೋದ.",
        "“ಓಹ್... ಶಬ್ಬಾಹಸ್ ಪುಟ್ಟ. ಹತ್ತು ಜೀರುಂಡೆಗಳನ್ನ ಸಂಗ್ರಹಿಸಿದ್ದಿ...” ಎಂದರು ಅಜ್ಜ."
      ]
    },
    {
      "n": 17,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p17.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಅಜ್ಜ ತುಂಬಾ ಖುಷಿಯಾಗಿದ್ದರು.",
        "ಜೀರುಂಡೆಗಳಿಗೆ ತುಂಬಾ ಹಸಿವಾಗಿತ್ತು!"
      ]
    },
    {
      "n": 18,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p18.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಜೀರುಂಡೆಗಳು ಕೀಟಗಳನ್ನೆಲ್ಲ ತಿಂದವು.",
        "ತೋಟ ಮೊದಲಿಂತೆ ಆಯಿತು."
      ]
    },
    {
      "n": 19,
      "image": {
        "src": "/data/picturebooks/580312-phaarookajjana-tota/p19.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಆವತ್ತಿಂದ ಅಜ್ಜನ ತೋಟ, ಹೆಚ್ಚೆಚ್ಚು ಹಣ್ಣು-ಹಂಪಲು ಬಿಡಲು ಪ್ರಾರಂಭಿಸಿತು."
      ]
    },
