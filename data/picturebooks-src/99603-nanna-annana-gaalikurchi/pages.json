    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/99603-nanna-annana-gaalikurchi/p02.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಗಾಲಿಕುರ್ಚಿಯಲ್ಲಿ ನನ್ನಣ್ಣ, ಜತೆಯಲ್ಲಿ ನಾನು. ನೋಡೋರೆಲ್ಲ ಹೇಳುವರು, ನಾವು ತರಲೆ ಜೋಡಿಗಳೆಂದು."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/99603-nanna-annana-gaalikurchi/p03.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಗಾಲಿಯ ಎರಡೂ ಚಕ್ರಗಳಿಗೆ ಹಚ್ಚಿದ್ದಾನೆ, ನೀಲಿ, ಹಳದಿ, ಕೆಂಪು ಬಣ್ಣ. ಆಗಾಗ ತಮಾಷೆಗೆ ಕಟ್ಟುತ್ತಾನೆ,",
        "ಪುಗ್ಗೆಗಳನ್ನು ಬಣ್ಣ ಬಣ್ಣ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/99603-nanna-annana-gaalikurchi/p04.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನನ್ನಣ್ಣ ತುಂಬಾನೇ ಜಾಣ, ತುಸು ಹೆಚ್ಚೇ ಚುರುಕು. ಜೋರು ಮಳೆಯಲ್ಲೂ ಅವನು, ಕೆಸರಿನಿಂದ ಪಾರಾಗಿಸುವನು ನನ್ನನ್ನು."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/99603-nanna-annana-gaalikurchi/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಸಂಜೆ ನಾವು ಆಟವಾಡಲು, ಪಾರ್ಕಿಗೆ ಹೋದಾಗಲೂ, ಮಾಡುವನು ಪಾಂ,ಪಾಂ ಸದ್ದು, ದಾರಿ ಮಾಡಿಕೊಡಲೆಂದು."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/99603-nanna-annana-gaalikurchi/p06.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಣ್ಣನ ಜತೆ ಹೋಗುವುದೇ ಮಜಾ ಸಂತೆಗೆ. ಹಿಂದೆ ಬರುವ ವಾಹನಗಳನ್ನು ನೋಡಲೆಂದೇ, ಕನ್ನಡಿ ಇದೆ ಅಣ್ಣನ ಕುರ್ಚಿಗೆ."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/99603-nanna-annana-gaalikurchi/p07.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಆಗಾಗ ಅವನು ಕುರ್ಚಿಯಲ್ಲಿ ಹತ್ತಿರಕ್ಕೆ ಹೋಗುವನು ತೊರೆಯ ಬಳಿ. ನಾನು ಅವನಿಗೆ ನೀರೆರಚುತ್ತೇನೆ. ಅಬ್ಬಾ, ಅವನ ಕೇಕೆ ಹೇಗಿರುತ್ತೆ ಗೊತ್ತಾ!"
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/99603-nanna-annana-gaalikurchi/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಬಾಬಾ ಮತ್ತು ಆಯಿ ನಮ್ಮನ್ನು ಕರಕೊಂಡು ಹೋದಾಗ ಬೆಟ್ಟ ಹತ್ತಲು, ಅದಕ್ಕೆಂದೇ ವಿಶೇಷ ಚಕ್ರಗಳನ್ನು-- ಗಾಲಿಕುರ್ಚಿಗೆ ಜೋಡಿಸಿಕೊಳ್ಳುವನು!"
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/99603-nanna-annana-gaalikurchi/p09.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನಮ್ಮ ಎಲ್ಲ ಗೆಳೆಯರು, ತಮ್ಮ ಸರತಿಗೆ ಕಾಯುತ್ತಾರೆ, ಗಾಳಿಗೆ ಕೈ ಚಾಚಿ, ತೇಲಾಡುತ್ತ, ಹೋಗುವುದೆಂದರೆ ಖುಷಿಯೋ ಖುಷಿ.",
        "ಅಣ್ಣ ಹೋಗುವ ವೇಗವನ್ನು ನೋಡಿ, ಅವನನ್ನು ಗಾಲಿಕುರ್ಚಿಯ ಪಂಟ ಎನ್ನುತ್ತಾರೆ. ಈಗಂತೂ ಸ್ನೇಹಿತರಿಗೆಲ್ಲ ಗೊತ್ತಾಗಿದೆ..."
      ]
