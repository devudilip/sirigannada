{
  "pages": [
    {
      "n": 1,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p01.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಅಯ್ಯೋ ನನ್ನ ಕನ್ನಡಕ!”",
        "ಅಯ್ಯೋ. ಇದು ಅಮ್ಮನದೆ ಧ್ವನಿ. ಅಮ್ಮ ಮತ್ತೆ ಕನ್ನಡಕ ಕಳೆದುಕೊಂಡಿದ್ದಾಳೆ."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p02.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಷ್ಟೇ ತಾನೆ. ನಾನು ಮತ್ತು ಮಿರ್ಚಿ ಸೇರಿ ಕನ್ನಡಕ ಹುಡುಕುತಿವಿ."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p03.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಸೋಫಾ ಕೆಳಗೆ ಒಂದು ಕೀ ಸಿಕ್ಕಿತು. ಕನ್ನಡಕ ಇಲ್ಲ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p04.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಆ ತಂತಿಯ ಮೇಲೆ ಎರಡು ಹಕ್ಕಿಗಳಿವೆ. ಕನ್ನಡಕ ಇಲ್ಲ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಡುಗೆ ಮನೆಯಲ್ಲಿ ನಾವು ಮೂರು ಡ್ರಾಯರುಗಳನ್ನು ತೆರೆದೆವು."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p06.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನನ್ನ ಹುಟ್ಟುಹಬ್ಬಕ್ಕಾಗಿ ತಂದಿದ್ದ ನಾಲ್ಕು ಚಾಕಲೇಟುಗಳು ಕಂಡವು!",
        "ಕನ್ನಡಕ ಇಲ್ಲ."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p07.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಶ್ಶ್‌…”",
        "ಇಲ್ಲಿ ನೋಡಿ ನಮಗೇನು ಸಿಕ್ಕಿತು ಅಂತ.",
        "ಮಿಯಾಂವ್!"
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಹೊದಿಕೆಯೊಳಗೆ ಐದು ಬೆಕ್ಕಿನ ಮರಿಗಳು!",
        "ಅಲ್ಲು ಕನ್ನಡಕ ಇಲ್ಲ."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p09.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಕಿಟಕಿಯ ಕಟ್ಟಿನಲ್ಲಿ ಆರು ಗಿಡಗಳು, ಬಲಕ್ಕು, ಎಡಕ್ಕು ತೂಗಾಡುತ್ತಿವೆ. ಕನ್ನಡಕ ಇಲ್ಲ."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p10.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನಾವು ಖುರ್ಚಿ ಮೇಲೆ ನೋಡಿದೆವು, ಟೇಬಲ್ಲಿನ ಕೆಳಗು ಮತ್ತೆ ಆ ಏಳು ಕಪಾಟುಗಳಲ್ಲಿ ಸಹ. ಕನ್ನಡಕ ಸಿಗಲಿಲ್ಲ."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p11.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಡೈನಿಂಗ್‌ ಟೇಬಲ್ಲಿನ ಮೇಲೆ ಎಂಟು ಚೀಲಗಳು. ಅದರಲ್ಲಿ ಬಗೆಬಗೆ ದಿನಸಿ. ಅದರಲ್ಲಿ ಅವಲಕ್ಕಿ ಸಿಕ್ಕಿತು, ಹಣ್ಣುಗಳು, ಒಂದು ದೊಡ್ಡ ಚಾಕೊಲೇಟು ಕೂಡ.",
        "ಆದರೆ ಕನ್ನಡಕವೆ ಇಲ್ಲ."
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p12.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಮ್ಮನ ಕೋಟಿನಲ್ಲಿ ಒಂಬತ್ತು ಜೇಬುಗಳಿವೆ. ಅದರಲ್ಲಿ…"
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p13.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಒಂದು ನಾಣ್ಯ, ಎರಡು ಟೀ ಪೊಟ್ಟಣಗಳು, ಮೂರು ಪೆನ್ನುಗಳು, ನಾಲ್ಕು ಕಾರ್ಡುಗಳು, ಐದು ಹೇರ್‌ ಪಿನ್ನುಗಳು, ಆರು ಕೀಗಳು, ಏಳು ರಸೀದಿಗಳು, ಎಂಟು ಬಟನ್ನುಗಳು ಒಂಬತ್ತು ಅಕ್ರೋಟುಗಳು...",
        "ಇನ್ನು ಕನ್ನಡಕ ಸಿಗಲಿಲ್ಲ."
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p14.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಉಸ್ಸಪ್ಪಾ!”",
        "“ಅಮ್ಮಾಆಆ!”"
      ]
    },
    {
      "n": 15,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p15.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಏನು?”"
      ]
    },
    {
      "n": 16,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p16.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ನಿನ್ನ ಕನ್ನಡಕ!”"
      ]
    },
    {
      "n": 17,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p17.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಅಬ್ಬಾ, ಕಡೆಗು ಕನ್ನಡಕ ಸಿಕ್ಕಿತಲ್ಲ! ಈಗ ನಿನಗೆ ಸಿಹಿ ಕೊಡಲೆಬೇಕು.”",
        "ಅಮ್ಮ ನನಗು ಮತ್ತು ಮಿರ್ಚಿಗಾಗಿ 10 ದೊಡ್ಡ, ರುಚಿಯಾದ ಲಾಡುಗಳನ್ನು ಮಾಡಿ ಕೊಟ್ಟರು."
      ]
    },
    {
      "n": 18,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p18.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ನನ್ನ ಫೋನ್!” ಎಂದು ಕಿರುಚಿದಳು ಅಮ್ಮ."
      ]
    },
    {
      "n": 19,
      "image": {
        "src": "/data/picturebooks/150016-mareguli-ammana-kannadaka/p19.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಯ್ಯೋ."
      ]
    }
  ]
}