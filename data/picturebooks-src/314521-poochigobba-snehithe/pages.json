        "“ಬಹುಶಃ ನನಗೆ ಸದಾ ಬಿಡುವಿಲ್ಲದೆ ಕೆಲಸ ಮಾಡದಂಥ,",
        "ಹೆಚ್ಚು ನಾಚಿಕೆಯಿಲ್ಲದ, ಅಷ್ಟಾಗಿ ರೌಡಿಯೂ ಅಲ್ಲದ",
        "ಸ್ನೇಹಿತನ ಅಗತ್ಯವಿದೆ,” ಎಂದುಕೊಂಡ ಪೂಚಿ."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/314521-poochigobba-snehithe/p10.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ನಸುಗೆಂಪು ಬಣ್ಣದ ಹೂವಿನ ಮಧ್ಯಭಾಗದಿಂದ ಮಧು ಹೀರುತ್ತಿದ್ದ",
        "ಹೊನ್ನ ಕಣಜವೊಂದನ್ನು ಪೂಚಿ ನೋಡಿದ.",
        "ಗಂಟಲನ್ನು ಸರಿಪಡಿಸಿಕೊಂಡು, “ಹ...ಹಲೋ?”",
        "ಅವನು ಭಯದಿಂದ ಮುದುಡಿದ; ಅವಳು ಚಿನ್ನದ ಮೈಯವಳು, ಸುಂದರಿ.",
        "“ನಾವುಸ್ನೇಹಿತರಾಗೋಣವೇ?” ಅವನಿಂದ ಮಾತು ಪಟಪಟನೆ ಉದುರಿತು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/314521-poochigobba-snehithe/p11.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಕಣಜ ಗಹಗಹಿಸಿ ನಕ್ಕಿತು.",
        "“ನಾನೇಕೆ ನಿನಗೆ ಸ್ನೇಹಿತೆಯಾಗಲಿ?”",
        "ಅವಳು ಕಣಜದ ಭಾಷೆಯಲ್ಲೇ ಉಲಿದಳು.",
        "ತನ್ನ ಗೂಡಿಗೆ ಹಾರಿಹೋಗುವ ಮುನ್ನ,",
        "“ಇಡೀ ಕಾಲನಿಯವರೆಲ್ಲ ನನಗೆ ಸ್ನೇಹಿತರು,”",
        "ಎಂದು ಮಾತು ಸೇರಿಸಿದಳು.",
        "ಪೂಚಿಗೆ ಅಳಬೇಕು ಅನ್ನಿಸಿತಾದರೂ ಯಾವ ಕಣ್ಣಿನಿಂದ ನೀರು",
        "ತೊಟ್ಟಿಕ್ಕಿಸಬೇಕು ಎಂದು ನಿರ್ಧರಿಸಲಾಗಲಿಲ್ಲ. ಹೀಗಾಗಿ",
        "ತಲೆಯಲ್ಲಿ ಬೇಸರ ತುಂಬಿಕೊಂಡು ಎಲೆಯೊಳಗೆ ಹುದುಗಿದನು.",
        "ಅಲ್ಲಿ ಆಗ ಚಳಿ, ತೇವ ಹಾಗೂ ಸ್ವಲ್ಪ ಗಬ್ಬು ನಾರುತ್ತಿರುವ",
        "ವಾಸನೆ. ಆದರೆ, ಅದನ್ನೇ ಅವನು ಇಷ್ಟಪಡುತ್ತಿದ್ದದ್ದು.",
        "“ಸ್ನೇಹಿತರ ಅಗತ್ಯ ಯಾರಿಗೆಲ್ಲ ಇದೆ?” ಯೋಚಿಸಿದ ಪೂಚಿ."
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/314521-poochigobba-snehithe/p12.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಆ ರಾತ್ರಿ ಬೀಸಿದ ದೊಡ್ಡ ಚಂಡಮಾರುತ ಪೂಚಿಯನ್ನು",
        "ಮುಚ್ಚಿದ್ದ ಎಲೆಯನ್ನು ಹಾರಿಸಿಕೊಂಡು ಹೋಯಿತು.",
        "ಮನೆಯಿಲ್ಲದ ಹಾಗೂ ಭಯಭೀತನಾದ ಪೂಚಿ",
        "ತಂತಾನೇ ಸುರುಳಿ ಸುತ್ತಿಕೊಂಡು ಚೆಂಡಿನಂತಾದ."
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/314521-poochigobba-snehithe/p13.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಮರುದಿನ ಬೆಳಗ್ಗೆ ಪೂಚಿಗೆ ತುಸು ಆರಾಮೆನಿಸಿತು ಹಾಗೂ",
        "ತನ್ನ 100 ಕಾಲುಗಳನ್ನು ಒಂದೊಂದಾಗಿ ಹೊರಚಾಚಿದ.",
        "ಮಣ್ಣಿನೊಳಗಿನ ತೂತಿನಿಂದ ಹೊರಬಂದ ಹಾಗೂ",
        "ತಿಂಡಿಯನ್ನು ಹುಡುಕುತ್ತಾ ಹಸಿರು ಹುಲ್ಲು ಇರುವತ್ತ ನಡೆದ."
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/314521-poochigobba-snehithe/p14.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "“ಈಈಈಈಈಈಈಈಈಈಈಈಈಕ್!”",
        "ತಲೆತಗ್ಗಿಸಿ ತನ್ನತ್ತ ನೋಡುತ್ತಾ ಚೀರುತ್ತಿದ್ದ ಪುಟ್ಟ",
        "ಹುಡುಗಿಯನ್ನು ಪೂಚಿ ತಲೆಎತ್ತಿ ನೋಡಿದ. ಬಹುಶಃ",
        "ಅವಳ ಶೂ ಮೇಲೆ ಅವನು ಸರಿದು ಬಂದಿದ್ದ ಎನಿಸುತ್ತದೆ.",
        "ತನ್ನ ಕುರೂಪದಿಂದ ವಿಪರೀತ ನಾಚಿಕೆಗೊಂಡ ಪೂಚಿ",
        "ಮುದುರಿ ಬಿಗಿಯಾಗಿ ಸುರುಳಿ ಸುತ್ತಿಕೊಂಡ ಹಾಗೂ",
        "ಅವಳನ್ನು ನೋಡಲು ನಿರಾಕರಿಸಿದ."
      ]
    },
    {
      "n": 15,
      "image": {
        "src": "/data/picturebooks/314521-poochigobba-snehithe/p15.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "“ಸ್‌ಸ್‌ಶ್‌!” ಇನ್ನೊಂದು ತಣ್ಣಗಿನ, ಮೃದು ದನಿ ಹೊಮ್ಮಿತು.",
        "“ಅದೋ ಸುಂದರವಾದ ಪುಟ್ಟ ಪೂಚಿ,” ಎಂದಿತು ಮೃದು ದನಿ.",
        "ಅದು ಯಾರೆಂದು ನೋಡಲು ಪೂಚಿ ತನ್ನ ಒಂದು ಕಣ್ಣನ್ನು ತೆರೆದ.",
        "ತನ್ನ ಹೆಸರು ಗೊತ್ತಿರುವವರು ಯಾರಿರಬಹುದು?",
        "ಇರು, ಅವನು ಸುಂದರ ಎಂದು ಯೋಚಿಸಿದವರು ಯಾರು?"
      ]
    },
    {
      "n": 16,
      "image": {
        "src": "/data/picturebooks/314521-poochigobba-snehithe/p16.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಕೊಂಬೆಯೊಟ್ಟಿಗೆ ಇದ್ದಂಥ ಎಲೆ ಮೇಲೆ",
