{
  "pages": [
    {
      "n": 1,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p01.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನೀಗ ದೊಡ್ಡ ಹುಡುಗನಾಗಿದ್ದೇನೆ. ಚಿತ್ರ ರಚಿಸಬಲ್ಲೆ. ಏನೆಲ್ಲ ವಸ್ತುಗಳನ್ನು ಮಾಡಬಲ್ಲೆ."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p02.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ಅಮ್ಮನ ಚಿತ್ರ ಬಿಡಿಸುವೆ. ಅವಳು ಅಲುಗಾಡದೆ ಕುಳಿತಿರುತ್ತಾಳೆ."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p03.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ನನ್ನ ತಂಗಿಯ ಚಿತ್ರ ಬಿಡಿಸುವೆ. ಆದರೆ, ಅವಳು ಸುಮ್ಮನೆ ಕುಳಿತಿರುವುದಿಲ್ಲ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p04.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ತರಹ ತರಹದ ಚಿತ್ರಗಳನ್ನು ಬಿಡಿಸುವೆ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p05.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಆದರೆ, ಗೋಡೆಯ ಮೇಲೆ ಬರೆಯಬಾರದು ಎಂದು ನನಗೆ ಹೇಳಿದ್ದಾರೆ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p06.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ಏನೇನೋ ವಸ್ತುಗಳನ್ನು ಮಾಡಬಲ್ಲೆ."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p07.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ಒಂದು ಬೆಕ್ಕಿನ ಚಿತ್ರ ಬಿಡಿಸುವೆ. ಅದು ಗುಂಡು ಗುಂಡಾಗಿ ಮುದ್ದಾಗಿದೆ."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p08.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ಮೀನು ಮಾಡುವೆ. ಅದು ತುಂಬ ಚಿಕ್ಕದು."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p09.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಾನು ಕಾಗದದಿಂದ ದೋಣಿಗಳನ್ನು, ಹಕ್ಕಿಗಳನ್ನು, ವಿಮಾನಗಳನ್ನು ಮಾಡುವೆ."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p10.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಮನೆಗಳನ್ನು, ರೈಲುಗಾಡಿಗಳನ್ನೂ ಮಾಡುವೆ."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/92309-naanu-eneno-vastugalannu-maadaballe/p11.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನನ್ನ ತಂಗಿ ಎಲ್ಲವನ್ನೂ ಹರಡುತ್ತಾಳೆ! ನಾನು ಅನೇಕ ವಸ್ತುಗಳನ್ನು ಮಾಡಬಲ್ಲೆ. ಆದರೆ, ಅವಳಿಗದು ಸಾಧ್ಯವಿಲ್ಲ!"
      ]
    }
  ]
}