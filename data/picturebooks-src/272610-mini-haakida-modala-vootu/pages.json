    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p02.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಮಿನಿ ಆರನೇ ತರಗತಿಯಲ್ಲಿ ಓದುತ್ತಿದ್ದಾಳೆ.",
        "ಅವಳ ವಿಶೇಷ ಏನಪ್ಪ ಅಂದ್ರೆ, ಕೆನ್ನೆಯ ಮೇಲೊಂದು ಡಿಂಪಲ್,",
        "ಹಾರಾಡುವ ಎರಡು ಜುಟ್ಟು, ಸದಾ ಮೂರು ದಿಕ್ಕಿನಲ್ಲಿ ಓಡುವ ಮನಸು.",
        "ಮೂರು ದಿಕ್ಕಿನಲ್ಲಿ ಓಡುವ ಮನಸಿನಿಂದ ಕೆಲವು ಸಲ",
        "ಉಪಯೋಗವಾಗುತ್ತದೆ, ಕೆಲವು ಸಲ ಆಗುವುದಿಲ್ಲ."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p03.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಹೀಗೆ ಮೂರೂ ದಿಕ್ಕಿನಲ್ಲಿ ಓಡುತ್ತಿರುವ ಮಿನಿ ಮನಸ್ಸು ಹೋಂ ವರ್ಕ್ ಮಾಡುವಾಗ,",
        "ಬೆಕ್ಕನ್ನು ಮುದ್ದಾಡುವಾಗ, ಜತೆಯಲ್ಲೇ ಬೇಸಿಗೆ ರಜೆಗಳ ಬಗ್ಗೆ ಕನಸು ಕಾಣುತ್ತಿರುವಾಗ ಉಪಯೋಗಕ್ಕೆ ಬರುತ್ತದೆ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p04.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಆದರೆ ಸಿಹಿ ತಿಂಡಿ ಅಂಗಡಿಗೆ ಹೋದಾಗ ಮಾತ್ರ ಕೈಕೊಡುತ್ತದೆ.",
        "ಮನಸಿನ ಒಂದು ಭಾಗದಲ್ಲಿ ಲಾಡುಗಳಿರುತ್ತವೆ. ಇನ್ನೊಂದು ಭಾಗ",
        "ಗುಲಾಬ್ ಜಾಮೂನ್ ಬಯಸಿದರೆ, ಮತ್ತೊಂದರಲ್ಲಿ ಬರ್ಫಿಗಳು ತುಂಬಿರುತ್ತವೆ.",
        "ಅಮ್ಮ, “ನನಗೆ ಏನು ಬೇಕು ಅಂತ ನಾಳೆ ಹೇಳುವೆ,” ಒಂದೇ ಸಲಕ್ಕೆ ಯಾವ",
        "ಸಿಹಿ ಬೇಕು ಅಂತ ಮಿನಿ ನಿರ್ಧಾರ ಮಾಡಿದ್ದೇ ಇಲ್ಲ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಈ ವಾರ ಮಿನಿ ಒಂದು ದೊಡ್ಡ ನಿರ್ಧಾರ ತೆಗೆದುಕೊಳ್ಳಬೇಕಿದೆ.",
        "ಅಂಗಡಿಯಲ್ಲಿ ಯಾವ ಸಿಹಿ ಬೇಕು ಎಂದು ಹೇಳುವುದಕ್ಕಿಂತ ದೊಡ್ಡದು.",
        "ಶಾಲೆಯ ಲೈಬ್ರರಿಯಲ್ಲಿ ಪುಸ್ತಕವನ್ನು ಆರಿಸಿಕೊಳ್ಳುವುದಕ್ಕಿಂತ ದೊಡ್ಡದು.",
        "ಸ್ಕೂಲ್ ಕ್ಯಾಪ್ಟನ್ ಆಯ್ಕೆಗೆ ಮಿನಿ ವೋಟು ಹಾಕಬೇಕಾಗಿದೆ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p06.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಅರುಣ್ ಎಂಟನೇ ತರಗತಿ ವಿದ್ಯಾರ್ಥಿ. ಅವನು ಎರಡು ಸಲ",
        "ವೋಟು ಹಾಕಿದ್ದಾನೆ - ಕಳೆದ ವರ್ಷ ಮತ್ತು ಅದರ ಹಿಂದಿನ ವರ್ಷ.",
        "ಸೋಮವಾರ ಬೆಳಗ್ಗೆ ಶಾಲೆಗೆ ಹೋಗುವಾಗ ಮಿನಿ",
        "ಕೇಳಿದಳು, “ನಾನು ಯಾರಿಗೆ ವೋಟು ಹಾಕಲಿ?”",
        "ಅರುಣ್ ಹೇಳಿದ, “ಅದು ನಿನ್ನ ವೋಟು. ನೀನೇ ನಿರ್ಧರಿಸಬೇಕು.”",
        "ಮಿನಿ ಗೊಂದಲದಲ್ಲಿ ಕೇಳಿದಳು, “ಹೇಗೆ ನಿರ್ಧರಿಸಲಿ?”",
        "ಅರುಣ್ ಹೇಳಿದ, “ಪೋಸ್ಟರ್ಸ್ ಓದು, ಭಾಷಣ ಕೇಳು.",
        "ಯಾರ ಮಾತಲ್ಲಿ ಭರವಸೆ ಬರುತ್ತದೋ ಅವರಿಗೆ ಹಾಕು.”"
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p07.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಮಿನಿ ಹಾಕುತ್ತಿರುವ ಮೊದಲ ವೋಟು ಇದು. ಆರನೇ ತರಗತಿಗೆ ಬಂದ ಮೇಲೆ ಮಾತ್ರ ವಿದ್ಯಾರ್ಥಿಗಳು",
        "ವೋಟು ಹಾಕಬಹುದು. ಅರುಣ್ ಹೇಳಿದ, “ಚೆನ್ನಾಗಿ ಕೆಲಸ ಮಾಡುವವರನ್ನು ಮಾತ್ರ ಸ್ಕೂಲ್ ಕ್ಯಾಪ್ಟನ್",
        "ಆಗಿ ಆರಿಸಬೇಕು ನೀನು.\" ಸ್ಕೂಲ್ ಕ್ಯಾಪ್ಟನ್ ಸ್ಥಾನಕ್ಕೆ ನಾಲ್ಕು ವಿದ್ಯಾರ್ಥಿಗಳು ಸ್ಪರ್ಧಿಸಿದ್ದರು.",
        "ಶಾಲೆಯ ಗೋಡೆಗಳೆಲ್ಲ ಅವರ ಫೋಟೋ ಮತ್ತು ಭರವಸೆಯ ಮಾತುಗಳ ಬಣ್ಣ ಬಣ್ಣದ",
        "ಪೋಸ್ಟರುಗಳಿಂದ ಕಂಗೊಳಿಸುತ್ತಿದ್ದವು. ರೆಸ್ಟ್ ಬಿಟ್ಟಾಗ, ಮಿನಿ, ಮೊಹಸಿನ್ ಎಲ್ಲ ಪೋಸ್ಟರ್ಸ್ ಓದಿದರು."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ದಿಯಾಳ ಪೋಸ್ಟರ್ಸ್ ಕಾಮನಬಿಲ್ಲಿನ",
        "ಬಣ್ಣಗಳಿಂದ ತುಂಬಿದ್ದವು.",
        "ಶಾಲೆಯಲ್ಲಿ ನಡೆವ ಚಿತ್ರಕಲಾ",
        "ಸ್ಪರ್ಧೆಗಳಲ್ಲಿ ಅವಳೇ ಗೆಲ್ಲುವುದು.",
        "ಪ್ರತೀಕ್ ಪೋಸ್ಟರುಗಳಲ್ಲಿ ಕ್ರಿಕೆಟ್,",
        "ಫುಟ್ ಬಾಲ್, ಚೆಸ್ ಆಟಗಳಿಗೆ ಸೇರಿದ",
        "ಭರವಸೆಗಳಿದ್ದವು. ಅವನು ಶಾಲೆಯ",
        "ಕ್ರಿಕೆಟ್ ತಂಡದ ನಾಯಕ.",
        "ರುಬಿನಾಳ ಪೋಸ್ಟರ್ಸ್",
        "ಸೀದಾ-ಸಾದಾ ಇದ್ದವು.",
        "ಶಾಲೆಗೆ ಬರಬೇಕು ಅಂದ್ರೆ",
        "ಮಕ್ಕಳಿಗೆ ಖುಷಿ ಆಗಬೇಕು.",
        "ಶಾಲೆ ಕೂಡ ಮೋಜಿನ ಜಾಗ",
        "ಎನ್ನುವ ಬಗ್ಗೆ ಹೇಳುತ್ತಿದ್ದವು.",
        "ದಿಯಾಳಿಗೆ ವೋಟು ಹಾಕಿ",
        "ನಿಮ್ಮ ವೋಟು ಪ್ರತೀಕ್ ಗೆ",
        "ರುಬಿನಾಳಿಗೆ ವೋಟು ಹಾಕಿ",
        "ಉತ್ತಮ ಶಾಲಾ ಅನುಭವಕ್ಕಾಗಿ"
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p09.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಕ್ಷಯ್ ಪೋಸ್ಟರ್ಸ್ ಅವನದೇ ಫೋಟೋಗಳಿಂದ ತುಂಬಿದ್ದವು.",
        "ಅವನು ಹೊಸ ಆಲೋಚನೆ ಮತ್ತು ಆತ್ಮವಿಶ್ವಾಸದ ಹುಡುಗನಾಗಿದ್ದ.",
        "ಅಕ್ಷಯ್ ಪೋಸ್ಟರ್ಸ್ ಕಪ್ಪುಹಲಗೆಗಿಂತ ದೊಡ್ಡದಾಗಿದ್ದವು.",
        "“ಇಷ್ಟು ದೊಡ್ಡ ಪೋಸ್ಟರ್ಸ್ ನಿಯಮಕ್ಕೆ ವಿರುದ್ಧ. ಆದರೂ ಗೆಲ್ಲುತ್ತಾನೆ. ಅವನು",
        "ಬೇಕು ಅಂದಿದ್ದನ್ನ ಸಾಧಿಸುತ್ತಾನೆ,” ಮೊಹಸಿನ್ ಮಿನಿಯ ಬಳಿ ಪಿಸುಗುಟ್ಟಿದ.",
        "ನಿಮ್ಮ ವೋಟು ಅಕ್ಷಯ್ ಗೆ"
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p10.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಇಡೀ ದಿನ ಮಿನಿಯ ಮನಸ್ಸು ಮೂರು ದಿಕ್ಕಿನಲ್ಲಿ ಓಡುತ್ತಿತ್ತು.",
        "ಸಂಜೆ ಅಮ್ಮನನ್ನು ಕೇಳಿದಳು, “ದಿಯಾಳ ಪೋಸ್ಟರ್ಸ್",
        "ತುಂಬಾ ಚೆನ್ನಾಗಿವೆ. ನಾನು ಅವಳಿಗೆ ವೋಟು ಹಾಕಲಾ?”",
        "ರಾತ್ರಿ ಊಟ ಮಾಡುವಾಗ ಅಪ್ಪನನ್ನು ಕೇಳಿದಳು,",
        "“ಅಕ್ಷಯನಿಗೆ? ಅವನವು ದೊಡ್ಡ ದೊಡ್ಡ ಪೋಸ್ಟರ್ಸ್.”"
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p11.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ರಾತ್ರಿ ಹಾಸಿಗೆಯ ಮೇಲೆ ಮಲಗಿಕೊಂಡು ಯೋಚಿಸುತ್ತಿದ್ದಳು.",
        "“ಅಥವಾ ಪ್ರತೀಕನಿಗೆ? ಮೊಹಸಿನನಿಗೂ ಪ್ರತೀಕ್ ಅಂದ್ರೆ ಇಷ್ಟ.”",
        "ಅಮ್ಮ ಲೈಟ್ ಆರಿಸುತ್ತ ಹೇಳಿದರು, “ಇದು ನಿನ್ನ ವೋಟು.",
        "ಯಾರಿಗೆ ಹಾಕಬೇಕು ಅಂತ ಯಾರೂ ನಿನಗೆ ಹೇಳುವುದಿಲ್ಲ.”",
        "ಮಿನಿ ಹೇಳಿಕೊಳ್ಳುತ್ತಿದ್ದಳು, “ರುಬಿನಾಳ ಪೋಸ್ಟರ್ಸ್ ನನಗೆ ಇಷ್ಟ ಆಗಿಲ್ಲ,",
        "ಹಾಗಾಗಿ, ಅವಳಿಗೆ ವೋಟು ಹಾಕುವ ಬಗ್ಗೆ ಯೋಚಿಸುವಂಥದ್ದು ಏನಿಲ್ಲ.”"
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p12.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಮಂಗಳವಾರ ಸ್ಪರ್ಧಿಗಳು",
        "ಗುರುತಿನ ಚಿಹ್ನೆಗಳನ್ನು ಹಂಚಿದರು.",
        "ದಿಯಾಳ ಗುರುತಿನ ಚಿಹ್ನೆ",
        "ನಕ್ಷತ್ರಗಳ ಆಕಾರದಲ್ಲಿದ್ದವು.",
        "ಪ್ರತೀಕ್ ಗುರುತಿನ ಚಿಹ್ನೆ",
        "ದುಂಡನೆಯ ಆಕಾರದಲ್ಲಿದಲ್ಲಿದ್ದವು."
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p13.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಕ್ಷಯ್ ಗುರುತಿನ ಚಿಹ್ನೆ ಚಿಕ್ಕ ವಸ್ತ್ರಗಳ",
        "ಆಕಾರದಲ್ಲಿದ್ದವು ಮತ್ತು ಅವು ದೊಡ್ಡವಿದ್ದವು.",
        "ಅವುಗಳ ಮೇಲೆ ಚಾಕಲೇಟ್ಸ್ ಅಂಟಿಸಲಾಗಿತ್ತು.",
        "ರುಬಿನಾಳ ಗುರುತಿನ ಚಿಹ್ನೆ ಚಿಕ್ಕದಾಗಿದ್ದವು ಮತ್ತು",
        "ಗಜಿಬಿಜಿಯಾಗಿದ್ದವು. ಅವುಗಳ ಮೇಲೆಲ್ಲ ಶಾಲೆ",
        "ಎಷ್ಟು ಖುಷಿಯಾದ ಜಾಗ ಎನ್ನುವುದನ್ನು ಬರೆದಿದ್ದಳು.",
        "ಹೆದರಿಸುವುದನ್ನು",
        "ನಿಲ್ಲಿಸಿ",
        "ಕ್ಲಾಸ್ ರೂಂ",
        "ಸ್ವಚ್ಛವಾಗಿಡೋಣ",
        "ಬಿಡುವಿನ",
        "ಸಮಯದಲ್ಲಿ",
        "ಸಂಗೀತ"
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p14.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಮಿನಿ ಚಾಕಲೇಟ್ ತಿನ್ನುತ್ತಾ ಮನೆಗೆ ಹೋಗುತ್ತಿದ್ದಳು.",
        "“ಅಕ್ಷಯನಿಗೆ ವೋಟು ಹಾಕಿದರೆ ಅವನು ಗೆಲ್ಲುತ್ತಾನೆ,",
        "ಆಗ ನಾವೆಲ್ಲ ಸಾಕಷ್ಟು ಚಾಕಲೇಟ್ಸ್ ತಿನ್ನಬಹುದು.”",
        "ಅರುಣ್ ಹೇಳಿದ, “ಅಕ್ಷಯ್ ಎಲ್ಲ ನಿಯಮಗಳನ್ನು ಮುರಿಯುತ್ತಿದ್ದಾನೆ.",
        "ಅಷ್ಟು ದೊಡ್ಡ ಪೋಸ್ಟರ್ಸ್ ಮಾಡಬೇಕಿರಲಿಲ್ಲ, ಚಾಕಲೇಟ್ಸ್ ಹಂಚಬೇಕಿರಲಿಲ್ಲ,",
        "ತನಗೆ ವೋಟು ಹಾಕುವಂತೆ ಒತ್ತಾಯಿಸಬೇಕಿರಲಿಲ್ಲ. ಆದ್ರೂ ಗೆಲ್ಲುತ್ತಾನೆ.”"
      ]
    },
    {
      "n": 15,
      "image": {
        "src": "/data/picturebooks/272610-mini-haakida-modala-vootu/p15.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಬುಧವಾರ ಭಾಷಣಗಳ ದಿನ.",
        "ದಿಯಾಳ ಭಾಷಣ ಅವಳ ಪೋಸ್ಟರುಗಳಂತೆ ಮುದ್ದಾಗಿತ್ತು.",
        "ಶಾಲೆಯಲ್ಲಿ ಚಿತ್ರಕತೆ ಮತ್ತು ಡ್ಯಾನ್ಸ್ ಕ್ಲಾಸ್ ನಡೆಸುವ ಬಗ್ಗೆ ಮಾತನಾಡಿದಳು.",
        "ಪ್ರತೀಕ್ ತುಂಬಾ ಉತ್ಸಾಹದಲ್ಲಿದ್ದ. ಅವನು ಆಟಗಳ ಬಗ್ಗೆ ಭಾಷಣ ಮಾಡಿದ.",
