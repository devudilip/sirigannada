    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/136417-asamo-adu-neena/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಷ್ಟು ಪುಟ್‌ - ಪುಟಾಣಿ ದೇಹ ಮತ್ತೆ ಆ ದೊಡ್ಡ, ಗುಂಡಗಿನ ಹೊಟ್ಟೆ.",
        "ಇಲ್ಲ.",
        "ನೀನು ಅಸಾಮೊ ಅಲ್ಲ."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/136417-asamo-adu-neena/p09.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಸಾಮೊ, ಅದು ನೀನೇನಾ?"
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/136417-asamo-adu-neena/p10.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ವೇಗದ ಹೆಜ್ಜೆಗಳಿಡುವ ಎಳೆಎಳೆ, ತುಪ್ಪುಳದ ಚೆಂಡು!",
        "ಇಲ್ಲ.",
        "ನೀನು ಅಸಾಮೊ ಅಲ್ಲ."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/136417-asamo-adu-neena/p11.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಸಾಮೊ, ಅದು ನೀನೇನಾ?"
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/136417-asamo-adu-neena/p12.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಗೂನುಬೆನ್ನಿನ, ತೊಟ್ಟಿಕ್ಕುವ ಜೋಲುಮೋರೆ ಅಷ್ಟೂದ್ದದ, ಕಪ್ಪು ಕೂದಲು.",
        "ಇಲ್ಲ.",
        "ನೀನು ಅಸಾಮೊ ಅಲ್ಲ."
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/136417-asamo-adu-neena/p13.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
