        "width": 708,
        "height": 508
      },
      "text": [
        "ಮೊದಲಿಗೆ, ಬಟ್ಟೆ ಅಂಗಡಿಯತ್ತ ಹಾರಿತು.",
        "ಅಲ್ಲಿ ನೀಲಿ ಜೀರುಂಡೆಯ ಬಳಿ ಕೇಳಿತು,",
        "“ನಿನ್ನತ್ರ ಕೆಂಪು ಅಂಗಿ ಇದೆಯ?”"
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/582044-bili-paataragitti/p10.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
