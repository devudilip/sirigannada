    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/582044-bili-paataragitti/p08.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಬಿಳಿ ಪಾತರಗಿತ್ತಿ ಮಾರ್ಕೆಟಿಗೆ ಹೋಗಲು ಸಜ್ಜಾಯಿತು."
