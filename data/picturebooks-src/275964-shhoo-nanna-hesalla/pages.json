      "text": []
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p02.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಶ್ಯೂ! ಗಾಲಿ ಕೆಳಗಡೆ ಬರ್ತಿದ್ದಿ, ಹೋಗಾಚೆ,” ಕಿರುಚಿದ ಬೈಕ್ ಸವಾರ.",
        "“ಶ್ಯೂ! ಆ ನಾಯಿಮರಿ ಕಚ್ಚೀತು. ಹೋಗ್ಬೇಡತ್ತ ಮಗು,” ಕೂಗಿದಳು ಅಮ್ಮ.",
        "“ಶ್ಯೂ! ತೊಲಗಾಚೆ, ನೀನಿದ್ರೆ ನನ್ನ ಅಂಗಡಿಗೆ ಜನ ಬರಲ್ಲ,” ಗದರಿದ ಚಾದಂಗಡಿವ."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p03.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಕಂದುಬಣ್ಣದ ನಾಯಿಮರಿ ಒಂದು ಮೂಲೆಯಲ್ಲಿ ಅಡಗಿ ಕುಳಿತಿತು.",
        "ಅದು ಎದರು ಬಂದರೆ ಸಾಕು ಎಲ್ಲರ ಬಾಯಲ್ಲಿ ಬರುವ ಮಾತು “ಶ್ಯೂ!”",
        "ಜನ ಯಾಕೆ ನನ್ನ ಹೆಸರು ಕರೆಯುತ್ತಿರುತ್ತಾರೆ ಎಂದು ಶ್ಯೂ ಯೋಚಿಸುತ್ತಿತ್ತು."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p04.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಶ್ಯೂ ಬೀದಿನಾಯಿ ಏನಲ್ಲ. ಅದು ಒಂದು ಮನೆಯಲ್ಲಿತ್ತು.",
        "ಆ ಮನೆಯ ಹುಡುಗ ಅದಕ್ಕೆ ತುಂಬಾ ಕಾಡಿಸುತ್ತಿದ್ದ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಹೊಸ ಆಟ ಆಡಿ ತೋರಿಸು!”",
        "“ಆ ಕೋಲು ತಾ!”",
        "“ಕಾಲುಗಳನ್ನ ಮೇಲೆತ್ತು!”",
        "ಹುಡುಗನ ಕಾಟಕ್ಕೆ ಶ್ಯೂ ಸುಸ್ತಾಗಿ ಬಿಡುತ್ತಿತ್ತು.",
        "ಆ ಹುಡುಗನನ್ನು ಕಂಡರೆ ಹೆದರಿ ಸಾಯುತ್ತಿತ್ತು."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p06.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಶ್ಯೂ ಜೊತೆಗೆ ಆಟವಾಡುವುದು ಹುಡುಗನಿಗೆ ಬೇಸರವಾಯಿತು.",
        "ಇದು ಹೊಸ ಆಟ, ಹೊಸ ಆಟಿಕೆ ಸಮಯ."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p07.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಆ ಹುಡುಗನ ತಂದೆ ಶ್ಶೂ ವನ್ನು ಬಸ್ ಸ್ಟ್ಯಾಂಡಿನಲ್ಲಿ ಬಿಟ್ಟು ಹೋದರು. ಅದು ಮನೆಯವರಿಗಾಗಿ ಕಾಯುತ್ತಿತ್ತು. ಕರೆದೊಯ್ಯುವವರು ಇರಲಿಲ್ಲ."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಬೀದಿಯ ಕೊಳೆಯಲ್ಲ ಶ್ಯೂ ಮೈಗೆ ಅಂಟಿಕೊಂಟಿತು.",
        "ನಿಧಾನಕ್ಕೆ ಕಸದ ತೊಟ್ಟಿಯ ಊಟ ರೂಢಿಯಾಯಿತು.",
        "ಮೊದಲಿಗೆ, ಬಿಸಿಬಿಸಿ ಮತ್ತು ಅಂಟಂಟು."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p09.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನಂತರ, ಹಸಿಹಸಿ ಮತ್ತು ತಣ್ಣಗೆ.",
        "ಶ್ಶೂ ಚಳಿ ಮತ್ತು ಹಸಿವಿನಿಂದ",
        "ಕಸದ ರಾಶಿಯ ಮೇಲೆ ಮಲಗಿತು."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p10.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಒಮ್ಮೆ ಆ ದಾರಿಯಲ್ಲಿ ಹೋಗುತ್ತಿದ್ದ ಅದಿತ್ ಕಣ್ಣಿಗೆ ಬಿದ್ದಿತು ಶ್ಶೂ.",
        "ಅವನು ಅದರ ಸಮೀಪ ಬಂದು ಪ್ರೀತಿಯಿಂದ ನೋಡಿದ.",
        "ಅದಿತ್ ತನ್ನ ಸ್ಕೂಲ್ ಬ್ಯಾಗಿನಿಂದ ಊಟದ ಡಬ್ಬಿ ಹೊರತೆಗೆದ.",
        "ಅದರಲ್ಲಿ ಒಂದೆರಡು ಇಡ್ಲಿಗಳು ಉಳಿದಿದ್ದವು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p11.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಇದಾದ ಮೇಲೆ ಅದಿತ್ ಪ್ರತಿದಿನ ತನ್ನ",
        "ಊಟವನ್ನು ಶ್ಶೂ ಜೊತೆ ಹಂಚಿಕೊಳ್ಳುತ್ತಿದ್ದ.",
        "ಮೊದಮೊದಲು ನಾಯಿಮರಿ ನಾಚಿಕೊಳ್ಳುತ್ತಿತ್ತು.",
        "ಅದಿತ್ ಅಲ್ಲಿಂದ ಹೋಗುವುದನ್ನು ಕಾಯುತ್ತಿತ್ತು.",
        "ಅವನು ತಿರುಗಿದ ತಕ್ಷಣ ಶ್ಯೂ ಗಬಗಬ ತಿನ್ನುತ್ತಿತ್ತು.",
        "ಇದು ಸ್ವಲ್ಪದಿನ ಮಾತ್ರ. ನಂತರ ಅದಿತ್ ಬೂಟಿನ ಸಪ್ಪಳಕ್ಕೆ ಬಾಲ",
        "ಅಲ್ಲಾಡಿಸಿ, ಕುಂಯ್ಞಿಗುಡುತ್ತ ಜಿಗಿದು ಅವನ ಮುಖ ನೆಕ್ಕುತ್ತಿತ್ತು.",
        "ಪ್ಲಚ್, ಪ್ಲಲ್ಚ್, ಪ್ಲಲ್ಚ್."
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p12.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಒಂದು ದಿನ, ಅದಿತ್ ಮನೆಗೆ ಹೋಗುತ್ತಿದ್ದಾಗ,",
        "ಶ್ಯೂ ಅವನ ಹಿಂದೆ ಹಿಂದೆ ಹೋಯಿತು.",
        "ಅದಿತ್ ತಿರುಗಿ ನೋಡಿದ ತಕ್ಷಣ,",
        "ಬಚ್ಚಿಟ್ಟುಕೊಳ್ಳುತ್ತಿತ್ತು ತಳ್ಳುಗಾಡಿಯ ಹಿಂದೆ,",
        "ಗಿಡದ ಹಿಂದೆ,",
        "ಸ್ಕೂಟರ್ ಹಿಂದೆ.",
        "ಅದಿತ್ ಜೇಬಿನಲ್ಲಿ ಕೈಯಿಟ್ಟುಕೊಂಡು",
        "ಶಿಳ್ಳೆ ಹಾಕುತ್ತ ಮನೆಕಡೆ ಹೋದನು."
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p13.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಮನೆ ಮುಟ್ಟಿದ ಮೇಲೆ ಅದಿತ್ ಹೇಳಿದ, “ಅಪ್ಪ ನೋಡಿಲ್ಲಿ.",
        "ಯಾರು ಬಂದಿದ್ದಾರೆ! ನಮ್ಮ ಮನೆಯಲ್ಲಿ ಸಾಕೋಣವ?”"
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p14.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಂದಿನಿಂದ ಶ್ಯೂ, ಅದಿತ್ ಬಾಲಂಗೋಚಿಯಾಯಿತು.",
        "ಅವನು ಸ್ನಾನ ಮಾಡುವಾಗ ಬಚ್ಚಲಾಚೆ ಕೂತಿರುತ್ತಿತ್ತು.",
        "ಬಾಗಿಲ ಬಳಿ ಕೂತು ಶಾಲೆಯಿಂದ ಬರುವುದನ್ನು ಕಾಯುತ್ತಿತ್ತು.",
        "ಅದಿತ್ ನನ್ನನ್ನು ಬಿಟ್ಟು ಹೋಗಿಬಿಟ್ಟರೆ? ವಾಪಸ್ ಬರದೆ ಇದ್ದರೆ?",
        "ಎಂದು ಅದು ಒಮ್ಮೊಮ್ಮೆ ಜೋಲು ಮುಖದಲ್ಲಿ ಕೂತಿರುತ್ತಿತ್ತು."
      ]
    },
    {
      "n": 15,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p15.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಒಂದು ವರ್ಷ ಕಳೆಯಿತು.",
        "ಅದಿತ್ ಮತ್ತು ಶ್ಯೂ ಒಂದು ನಿಮಿಷ ಬಿಟ್ಟಿರುತ್ತಿರಲಿಲ್ಲ.",
        "ಅದಿತ್ ತನ್ನನ್ನು ಬಿಟ್ಟು ಹೋಗುವುದಿಲ್ಲ. ಹೋದರೂ,",
        "ವಾಪಸ್ ಬರುತ್ತಾನೆ ಎನ್ನುವುದು ಅದಕ್ಕೆ ಅರ್ಥವಾಯಿತು.",
        "ಕಂದುಬಣ್ಣದ ನಾಯಿಮರಿಗೆ ಹೊಸ ಹೆಸರು ಇಡಲಾಯಿತು."
      ]
    },
    {
      "n": 16,
      "image": {
        "src": "/data/picturebooks/275964-shhoo-nanna-hesalla/p16.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಟಾಫೀ, ಓಡಬೇಡ ನಿಲ್ಲು. ನನ್ನ ಪುಸ್ತಕ ಕೊಡು!”"
      ]
    }
  ]
}