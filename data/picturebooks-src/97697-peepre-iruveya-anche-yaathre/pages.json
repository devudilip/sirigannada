{
  "pages": [
    {
      "n": 1,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p01.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಗೂಡಿನಿಂದ ತಲೆ ಎತ್ತಿದ ಪೀಪ್ರೆ ಇರುವೆಗೆ ಸೂರ್ಯ ಕಂಡ ಬೂಂದಿ ಲಾಡುವಿನಂತೆ."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p02.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಪೀಪ್ರೆ ಇರುವೆ ಚರಪರನೇ ಹಸುರೆಲೆ ಹತ್ತುವಾಗಲೇ."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p03.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ರೊಯ್ಯನೇ ಬೀಸಿದ ಗಾಳಿಗೆ ಹಾರಿತು ಹಸುರೆಲೆ ಮೇಲೆ ಮೇಲೆ..."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p04.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "...ತೊಪ್! ಅದಾಗಿತ್ತು ಕೆಂಪು ಅಂಚೆಪೆಟ್ಟಿಗೆ. ಎಲ್ಲೆಲ್ಲೂ ಕತ್ತಲೆ, ಹೆಜ್ಜೆ ಇಟ್ಟಿತು ಪೀಪ್ರೆ ಮೆಲ್ಲನೆ. ಪತ್ರವೊಂದರ ಮೇಲೆ ಕೆಂಪು, ನೀಲಿ, ಹಸುರಿನ ಸ್ಟಾಂಪು ಅದರ ಮೇಲೆ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p05.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಕರಪರ ಕರಪರ ಎನ್ನುತಾ ಆಗಲೇ ನುಗ್ಗಿ ಬಂತೊಂದು ಕೈ ಪೆಟ್ಟಿಗೆಯೊಳಗೆ ಪತ್ರಗಳ ಬಾಚಿ ತುಂಬಿತು ದೊಡ್ಡ ಚೀಲಕೆ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p06.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಜೂಂಯ್ ಧಬ್... ಚೀಲ ಏರಿಸಿ ಹೊರಟಳು ಅಂಚೆಯಕ್ಕ. ಡುರ್ ರ್ ರ್ ಎನ್ನುತಾ ಸ್ಕೂಟರ್ ಮೇಲೆ."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p07.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಖಚಕ್. ಉರುಳಿ ಬಿತ್ತು ಧುಡುಮ್ಮನೆ ಪೀಪ್ರೆ ಒಂದು ಪತ್ರದ ಮೇಲೆ."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p08.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಸರಸರನೆ ಸರಿಯಿತು ಪೀಪ್ರೆ. ಶುಭಾಶಯ ಪತ್ರದ ಮೇಲೆ."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p09.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಅಂಚೆಯಕ್ಕನ ಚೀಲ ಈಗ ಟೇಬಲ್ ಮೇಲೆ. ಪತ್ರಗಳ ಸುರಿದಳು ಒಂದೊಂದರ ಮೇಲೆ.",
        "ಟಪ್ ಟಪ್ ಟಪ್… ಎಂದು ಬಿದ್ದಿತು ಠಸ್ಸೆ."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p10.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ನೆಲಕೆ ಬಿದ್ದವು ಪತ್ರಗಳು ಧಬಧಬನೇ. ಆಯಿತೊಂದು ದೊಡ್ಡ ಗುಪ್ಪೆ. ದೆಹಲಿ, ಮುಂಬಯಿ ಒಂದಿಷ್ಟು. ಕೋಹಿಮ, ಕುಂದಾಪುರಕ್ಕೆ ಅಷ್ಟಿಷ್ಟು. ಪುಣೆ, ಬೆಂಗಳೂರಿಗೂ ಮತ್ತಷ್ಟು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p11.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಜೋತು ಬಿತ್ತು ಪತ್ರವೊಂದಕೆ ಪೀಪ್ರೆ. ಆ ಪತ್ರ ದೊಡ್ಡ ಬ್ಯಾಗೊಂದ ಸೇರೆ. ಆ ಬ್ಯಾಗು ಅಂಚೆಗಾಡಿಗೆ ಬೀಳೆ. ಪೋಂಪೋಂ ನ ಸದ್ದು ಅಲ್ಲೆಲ್ಲಾ ಕೇಳೆ."
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p12.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಪೀಪ್ರೆ ತಲೆಕೆಳಗಾಗಿದ್ದ ಪೋಸ್ಟ್ ಕಾರ್ಡ್ ಓದಿತು. “ಸ್ಕೂಲು ಅಂದರೆ ನಿನಗಿಷ್ಟಾನಾ ತನು? ಪ್ರೀತಿಯಿಂದ, ನಿನ್ನ ಅಜ್ಜಿ.” ಎಂದಿತ್ತು. ಗುಲಾಬಿ ಪತ್ರದ ಮೇಲೆ ನೀಲಿ ಇಂಕಲ್ಲಿತ್ತು, “ಹೇಳಿ ನೋಡು ಚಂದಮಾಮನ ಹಾಡು?”"
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p13.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಸ್ಕ್ರೀ ಈಈ - ಚ್ಕ್. ವ್ಯಾನು ಗಕ್ಕನೆ ನಿಂತಿತು ಮನೆ ಎದುರು. ಕಿರ್ ರ್ ಸದ್ದಾಯಿತು ಗೇಟು. ಪೋಸ್ಟ್... ಎಂದು ಕೂಗಿ ಪತ್ರ ಎಸೆದಿತ್ತು. ಪಟ್ ... ಎಂದು ಅದು ಬಾಗಿಲೆದುರು ಬಿದ್ದಿತು."
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/97697-peepre-iruveya-anche-yaathre/p14.jpg",
        "width": 708,
        "height": 507
      },
      "text": [
        "ಟ್ರಿಂಗ್ ಟ್ರಿಂಗ್... ಪೀಪ್ರೆಗೆ ಕೇಳಿತು ಕಾಲಿಂಗ್ ಬೆಲ್ಲು. ‘ಅಮ್ಮಆ! ಅಜ್ಜಿ ನನಗೆ ಪತ್ರ ಬರೆದಿದ್ದಾರೆ,’ ಎಂದಿತು ಮಗು. ಪೀಪ್ರೆಗೂ ಗೊತ್ತಾಯಿತು ಆ ಪತ್ರದ ಜಾಡು."
      ]
    },
