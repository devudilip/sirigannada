      },
      "text": [
        "ನೇತಾಡುವ ಬೇರುಗಳೊಂದಿಗೆ ಒಂದು ಆಲ",
        "ದೃಢವಾಗಿ ನಿಂತಿದೆ ವಿಶಾಲ."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/19236-namma-adbhutha-maragalu/p02.jpg",
        "width": 708,
        "height": 784
      },
      "text": [
        "ತೋಟದಲ್ಲಿ ಹೂ ಬಿಡುವ ಎರಡು ಮರಗಳು,",
        "ಸಿಹಿಯಾದ ಮಕರಂದ ದುಂಬಿಗಳಿಗೆ ಹೀರಲು."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/19236-namma-adbhutha-maragalu/p03.jpg",
        "width": 708,
        "height": 784
      },
      "text": [
        "ಊರ ಬೀದಿಯಲ್ಲಿ ಮೂರು ಅರಳಿ ಮರಗಳು ಹಣ್ಣುಗಳನ್ನು ಸವಿಯಲು ಹಿಂಡು ಹಿಂಡು ಗಿಳಿಗಳು."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/19236-namma-adbhutha-maragalu/p04.jpg",
        "width": 708,
        "height": 784
      },
      "text": [
        "ಹೊಲದಲ್ಲಿ ತೂಗುತ್ತಿವೆ ನಾಲ್ಕು",
        "ಬೇವಿನ ಮರಗಳು, ಕೀಟಗಳನ್ನು ದೂರವಿಡಲು ಅದರ ಕಹಿ ತಿರುಳು."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/19236-namma-adbhutha-maragalu/p05.jpg",
        "width": 708,
        "height": 784
      },
      "text": [
        "ಬಳುಕುವ ತೊರೆಯ ಬಳಿ ಐದು",
        "ನೇರಳೆ ಮರಗಳು,",
        "ನೆಲದ ತುಂಬಾ ಚೆಲ್ಲಿವೆ ಅದರ ಹಣ್ಣುಗಳು."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/19236-namma-adbhutha-maragalu/p06.jpg",
        "width": 708,
        "height": 784
      },
      "text": [
        "ತೋಟದಂಚಿನಲ್ಲಿ ಆರು ಹಾಲವಾಣ ಮರಗಳು, ಹಕ್ಕಿಗಳನ್ನು ಸೆಳೆಯಲು ಕಡುಗೆಂಪು ಹೂಗಳು."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/19236-namma-adbhutha-maragalu/p07.jpg",
        "width": 708,
        "height": 784
      },
      "text": [
        "ಏಳು ದೇವದಾರು ಮರಗಳು ಪರ್ವತದ ಮೇಲೆ, ರೆಂಬೆ-ಕೊಂಬೆಗಳಿಂದ ಎಣ್ಣೆ, ಸುಗಂಧದ ಮಾಲೆ."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/19236-namma-adbhutha-maragalu/p08.jpg",
        "width": 708,
        "height": 784
      },
      "text": [
        "ಎಂಟು ಹುಣಸೆ ಮರಗಳು ಈ ಪುಟ್ಟ ಊರಲಿ,",
        "ಹುಳಿ ಹುಳಿ ಹಣ್ಣುಗಳೆಂದರೆ ನೀರೂರುತ್ತೆ ಬಾಯಲ್ಲಿ."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/19236-namma-adbhutha-maragalu/p09.jpg",
        "width": 708,
        "height": 784
      },
      "text": [
        "ದಟ್ಟ ಅಡವಿಯಲ್ಲಿ ಒಂಬತ್ತು ಮುತ್ತುಗದ ಮರಗಳು, ತಟ್ಟೆಯಗಲದ ಎಲೆಗಳಿಂದ ಚೆಂದದ ಊಟದೆಲೆಗಳು."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/19236-namma-adbhutha-maragalu/p10.jpg",
        "width": 708,
        "height": 784
      },
      "text": [
        "ಸುಡುವ ಮರುಭೂಮಿಯಲ್ಲಿ ಹತ್ತು ಬನ್ನಿ ಮರಗಳು,",
        "ಒಂಟೆಗಳಿಗೆ ತಿನ್ನಲು ಅದರ",
        "ಚಿಗುರಾದ ಎಲೆಗಳು."
      ]
    },
    {
      "n": 11,
      "image": null,
      "text": [
        "ಉಸಿರು ಗಾಳಿ ಕೊಡುತ್ತವೆ ಮರಗಳು",
        "ಮಣ್ಣನ್ನು ರಕ್ಷಿಸುತ್ತವೆ ಮರಗಳು",
        "ಬಿಸಿಲಿಂದ ಮರಗಳಿಗೆ ಆಹಾರ",
        "ಮರಗಳಿಂದ ತಂಪು ವಿಹಾರ",
        "ಮರಗಳಿಂದಲೇ ಭೂಮಿಗೆ ಮೌಲ್ಯ...",
        "ಹೌದು... ಮರಗಳು ಅಮೂಲ್ಯ.",
        "ಎಲ್ಲೆಡೆಯೂ, ಎಂದೆಂದಿಗೂ",
        "ಮರಗಳು ಅಮೂಲ್ಯ."
      ]
    }
  ]
