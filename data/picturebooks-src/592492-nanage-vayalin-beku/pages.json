      },
      "text": [
        "ಪಾತರಗಿತ್ತಿ ಮತ್ತು ಡ್ರಾಗನ್‌ಫ್ಲೈ ಹುಲ್ಲಿನ ಮೇಲೆ ಕುಳಿತವು. ಪಾತರಗಿತ್ತಿ ಚೆಂದವಾಗಿ ಹಾಡಲು ಪ್ರಾರಂಭಿಸಿತು."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p02.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಡ್ರಾಗನ್‌ಫ್ಲೈ ಬೇಸರದಲ್ಲಿದೆ. ಅದಕ್ಕೂ ಹಾಡಬೇಕೂ ಅಂತ ಆಸೆ. ಆದರೆ, ಅದರ ವಯಲಿನ್ ಕಳೆದು ಹೋಗಿದೆ."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p03.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "“ನನ್ನ ಹತ್ರ ಒಂದು ಉಪಾಯ ಇದೆ,” ಎಂದಿತು ಪಾತರಗಿತ್ತಿ."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p04.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಪಾತರಗಿತ್ತಿ, ಡ್ರಾಗನ್‌ಫ್ಲೈ ಜೀರುಂಡೆ ಮನೆಯತ್ತ ಹಾರಿದವು.",
        "ಜೀರುಂಡೆ ಶೇಂಗಾ ಸುಲಿಯುತ್ತಿತ್ತು. ಇವೆರಡೂ ಅದಕ್ಕೆ ಸಹಾಯ ಮಾಡಿದವು. ಬದಲಾಗಿ ಜೀರುಂಡೆ",
        "ಶೇಂಗಾ ಸಿಪ್ಪೆಯನ್ನು ಕೊಟ್ಟಿತು."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p05.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಮುಂದೆ, ಇವೆರೆಡೂ ಮಿಡತೆಗೆ ಹುಲ್ಲುಹಾಸನ್ನು ಕತ್ತರಿಸಲು ಸಹಾಯ ಮಾಡಿದವು."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p06.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಬದಲಾಗಿ, ಅದು ತನ್ನ ಹುಲ್ಲುಹಾಸಿನಿಂದ ಸ್ವಲ್ಪ ಹುಲ್ಲು ಕೊಟ್ಟಿತು."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p07.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಕೊನೆಯಲ್ಲಿ ಇವೆರೆಡೂ ಜೇನ್ನೋಣಕ್ಕೆ ಜೇನು ಹುಡುಕಲು ಸಹಾಯ ಮಾಡಿದವು."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p08.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಜೇನ್ನೋಣಗಳು “ಥ್ಯಾಂಕ್ಸ್!” ಹೇಳುತ್ತ ಒಂದು ಸಣ್ಣ ಮೇಣದ ಚೆಂಡನ್ನೂ ಕೊಟ್ಟವು."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p09.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಪಾತರಗಿತ್ತಿ ಜೇಡರಬಲೆ ಹುಡುಕಲು ಪ್ರಾರಂಭಿಸಿತು.",
        "“ಈಗ ಏನು ಮಾಡುತ್ತಿದ್ದೀ?” ಎಂದು ಗೋಳಾಡಿತು ಡ್ರಾಗನ್‌ಫ್ಲೈ."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p10.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಡ್ರಾಗನ್‌ಫ್ಲೈಗೆ ಸಾಕು ಸಾಕಾಗಿತ್ತು. ನೀ ಏನಾದರೂ ಮಾಡು ನಾ ಮಲಗುತ್ತೇನೆ ಎಂದು ಹೋಯಿತು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p11.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಇದ್ದಕ್ಕಿದ್ದಂತೆ, ಮಧುರ ನಾದವೊಂದು ಕೇಳಿ ಅದಕ್ಕೆ ಎಚ್ಚರವಾಯಿತು!"
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p12.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಓಹ್ ಸೂಪರ್! ನಮಗೆ ಬಂದ ಉಡುಗೊರೆಗಳನ್ನು ಬಳಸಿ ಪಾತರಗಿತ್ತಿ ವಯಲಿನ್ ತಯಾರಿಸಿದೆ!"
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p13.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "“ಈಗ ನಾನು ಹಾಡುವಾಗ, ನೀನು ನನ್ನೊಂದಿಗೆ ವಯಲಿನ್ ನುಡಿಸಬಹುದು,” ಎಂದಿತು ಪಾತರಗಿತ್ತಿ."
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/592492-nanage-vayalin-beku/p14.jpg",
        "width": 639,
        "height": 689
      },
      "text": [
        "ಈಗ ಪಾತರಗಿತ್ತಿ ಹಾಡಿದಾಗೆಲ್ಲ ಡ್ರಾಗನ್‌ಫ್ಲೈ ವಯಲಿನ್ ನುಡಿಸುತ್ತದೆ."
      ]
    }
  ]
