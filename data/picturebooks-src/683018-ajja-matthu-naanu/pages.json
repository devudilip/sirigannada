        "width": 2234,
        "height": 1604
      },
      "text": [
        "ನಾನು ಮತ್ತು ಅಜ್ಜ ಸೇರಿದರೆ ಮಜವೋ ಮಜಾ,",
        "ಕೆಲವು ಕೆಲಸ ಮಾಡುವುದು ಇಬ್ಬರಿಗೂ ಸಜಾ."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p02.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಮೇಲಿನ ಕಪಾಟಿನ ಸಕ್ಕರೆ ಜಾಡಿ ಎಟುಕಿಸಲಾರೆ ನಾನು,"
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p03.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಕೆಳಗಿನ ಕಪಾಟಿನ ತಮ್ಮ ಚಾಕಲೇಟಿಗಾಗಿ ಬಾಗಲಾರರು ಅವರು."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p04.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಅಳದೆ ಸೊಪ್ಪು ತಿನಲಾರೆ ನಾನು,",
        "ಕಿರುಚದೆ ಐಸ್ ಕ್ರೀಂ ತಿನಲಾರರು ಅವರು."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p05.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಅವರ ಟಿವಿಯ ಹಳೆಯ ರಿಮೋಟ್ ಬಳಸಲಾರೆ ನಾನು,",
        "ನನ್ನ ಮೊಬೈಲಿನ ಹೊಸ ಹೊಸ ಆಟಗಳನು ಆಡಲಾರರು ಅವರು."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p06.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಅವರ ಊಟದ ಖುರ್ಚಿಯ ಏರಲಾರೆ ನಾನು,"
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p07.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಉಸ್ಸಪ್ಪ ಎನದೆ ನನ್ನ ಡೇರೆಯೊಳಗೆ ನುಸುಳಲಾರರು ಅವರು."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p08.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಭಾರತದ ಎಲ್ಲ ರಾಜ್ಯಗಳ ರಾಜಧಾನಿಗಳ ಹೆಸರು ಗೊತ್ತಿಲ್ಲ ನನಗೆ, ಆದರೆನಂತೆ ನೆನಪಿಲ್ಲ ಎಷ್ಟೋ ಮಹತ್ವದ ದಿನಗಳು ಅವರಿಗೆ."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p09.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಕಾರು ಓಡಿಸಲು ಬರದು ನನಗೆ, ಈಗಲೇ ಕಲಿಯಲೂ ಆಗದು,"
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p10.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಅವರಿಗೆ ಈಗ ಸೈಕಲ್ ಸರಿಯಾಗಿ ಓಡಿಸಲು ಆಗದು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p11.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ನಾನು ಮರೆವೆ ರಾತ್ರಿ ಹಲ್ಲು ಉಜ್ಜುವುದು ಒಮ್ಮೊಮ್ಮೆ,",
        "ಅವರ ಔಷಧಿ ಕಾಣದಾಗುವುದು ಒಮ್ಮೊಮ್ಮೆ."
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p12.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ಕನ್ನಡಕ ಇಲ್ಲದೆ ಏನೂ ಕಾಣದು ಅವರಿಗೆ,",
        "ಅವರ ಕನ್ನಡಕದಲ್ಲಿ ಏನೂ ಕಾಣದು ನನಗೆ."
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p13.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ನಾವಿಬ್ಬರೂ ಮಾಡಲಾರೆವು ಕೆಲವು ಕೆಲಸ,",
        "ಇಬ್ಬರೂ ಸೇರಿ ಮಾಡುವೆವು ಒಂದು ಮಜವಾದ ಕೆಲಸ."
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/683018-ajja-matthu-naanu/p14.jpg",
        "width": 2234,
        "height": 1604
      },
      "text": [
        "ನನಗೆ ಓದಲು ಬರೋದೇ ಚೂರು. ಬಹಳ ಓದು ಅವರದು.",
        "ನಂಗೆ ಭಾರಿ ಇಷ್ಟ ಅಜ್ಜ ಪುಸ್ತಕ ತಂದು ಓದಿ ಹೇಳೋದು."
      ]
    }
  ]
}