      },
      "text": [
        "ಇದೇ ನೋಡಿ ಫೈಜುನ ಕನಸಿನ ದುನಿಯ. ಸಿಹಿ ತಿನಿಸುಗಳ ಸಿಹಿಸಿಹಿ ದುನಿಯ. ಇಲ್ಲಿದೆ ಬಣ್ಣ ಬಣ್ಣದ ಮಿಠಾಯಿ, ಪಾಯಸ, ಪೇಡ ಜೊತೆಗಿದೆ ರಸಮಲೈ."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p02.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಕರೆಯೋಣ ಮೊದಲು ತುಪ್ಪದ ರಾಜನ. ಮಹಾರಾಜ ಮೈಸೂರ್ ಪಾಕು! ಬನ್ನಿ ಇಲ್ಲಿ!"
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p03.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಮೈಸೂರ್ ಪಾಕು! ಮೈಸೂರ್ ಪಾಕು! ಚೂಪು ಮೂತಿಯ ಸವಿಸವಿ ಪಾಕು. ರಾಜ ಇಲ್ಲಿ ದರಬಾರಿನಲ್ಲಿ, ಚಂದಿರವದನೆ ರಾಣಿ ಎಲ್ಲಿ?"
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p04.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಕಾಜೂ ಕತಲಿ! ಕಾಜೂ ಕತಲಿ! ಮಿಂಚುವ ಬಳಕುವ ಕಾಜೂ ಕತಲಿ. ಇವಳದು ಗೋಡಂಬಿಯ ಮೈಬಣ್ಣ, ಬನ್ನಿ, ಜಿಲೇಬಿ ಸಂಗಡ ಕುಣಿಯೋಣಣ್ಣ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p05.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಕಿತ್ತಳೆ ಬಣ್ಣದ ಜಿಲೇಬಿ! ಕಿತ್ತಳೆ ಬಣ್ಣದ ಜಿಲೇಬಿ! ಸುರುಸುರುಳಿ ಸುತ್ತಿದ ಕಿತ್ತಳೆ ಬಣ್ಣದ ಜಿಲೇಬಿ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p06.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಜಿಲೇಬಿಗೆ ಕೈಗಳು ಎಷ್ಟು? ಲಾಡುನಲ್ಲಿರೋ ಬೂಂದಿ ಕಾಳುಗಳಷ್ಟು."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p07.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಬೂಂದಿ ಲಾಡು! ಬೂಂದಿ ಲಾಡು! ಉರುಳುರುಳಾಡುವ ಬೂಂದಿ ಲಾಡು."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p08.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಯಾರಿರುವರು ಗುಂಡಗೆ ಲಾಡು ತರಹ? ಹೊಳೆಯುವ ಗುಂಡಮ್ಮ ಜಾಮೂನ್ ಕಣಮ್ಮ."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p09.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಗುಲಾಬ್ ಜಾಮೂನ್! ಗುಲಾಬ್ ಜಾಮೂನ್! ಸಕ್ಕರೆ ಪಾಕದಿ ಮುಳುಗೆದ್ದ ಜಾಮೂನ್. ಮತ್ತಾರಿಲ್ಲಿ ಈಜಬಲ್ಲರು? ಇದೆಯಲ್ಲ ನಮ್ಮ ಈ ರಸಗುಲ್ಲ."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p10.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಮುದ್ದು ರಸಗುಲ್ಲ! ಚಿನ್ನಾರಿ ರಸಗುಲ್ಲ! ಮೆದುವಾದ ಸಿಹಿಯಾದ ರಸಗುಲ್ಲ. ಅಲ್ಲಿ ಇಲ್ಲಿ ಉರುಳಾಡಿತು ರಸಗುಲ್ಲ, ಕೇಳಿತು ಹಲ್ವಾ, “ಎಲ್ಲಿಗೆ ಹೋಗಬೇಕಕ್ಕ?”"
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/676706-sihisihi-kanasau/p11.jpg",
        "width": 3351,
        "height": 2406
      },
      "text": [
        "ಕ್ಯಾರೆಟ್‌ ಹಲ್ವಾ! ಕ್ಯಾರೆಟ್‌ ಹಲ್ವಾ! ಬಿಸಿ ಬಿಸಿ ಕ್ಯಾರೆಟ್‌ ಹಲ್ವಾ. ಬಾಯೊಳಗಿಟ್ಟರೆ ಹಲ್ವಾ, ಜೊಲ್ಲು ಸುರಿಯಿತಲ್ಲ,"
      ]
    },
