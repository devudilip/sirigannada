    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/589522-appugeya-dina/p10.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ಬೆಕ್ಕಮ್ಮನನ್ನ ಅಪ್ಪಿಕೊಳ್ಳುವ ಮಜವೇನು ಗೊತ್ತಾ?",
        "ಅದರ ಮರಿಗಳನ್ನೂ ಮುದ್ದಾಡಬಹುದು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/589522-appugeya-dina/p11.jpg",
        "width": 708,
        "height": 382
      },
      "text": [
        "ಅಷ್ಟೇ ಏಕೆ, ಪ್ರಾಣಿ ಸಂಗ್ರಹಾಲಯದ ದೊಡ್ಡ ಬೆಕ್ಕುಗಳನ್ನೂ ಅಪ್ಪಿಕೊಳ್ಳಲು ಹೋಗಿದ್ದೆ.",
        "ಆದರೆ, ಪ್ರಾಣಿ ಪಾಲಕರು, “ಅಯ್ಯೋ, ಬೇಡಮ್ಮ!” ಅಂದುಬಿಟ್ಟರು, ಇರಲಿ."
      ]
    },
