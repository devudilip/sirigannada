    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/589522-appugeya-dina/p08.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ನಾನೊಂದು ಉದ್ದ ಬೆಕ್ಕನ್ನು ಮುದ್ದು ಮಾಡಿದೆ.",
        "ಹಾಗಂತ ಕುಳ್ಳ ಬೆಕ್ಕನ್ನೂ ಬಿಡಲಿಲ್ಲ."
