{
  "pages": [
    {
      "n": 1,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p01.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ದೃಶ್ಯ - 1"
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p02.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನೋಡ್ರಪ್ಪೋ ನೋಡಿ, ನಾನು ಮಾನವ, ನನಗೆಲ್ಲವೂ ಗೊತ್ತು!"
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p03.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನೋಡಿ, ಇಲ್ಲಿವೆ ನನ್ನ ಕಣ್ಣುಗಳು, ನನ್ನ ಕಣ್ಣಿನಿಂದ ನಾನು ಜಗತ್ತನ್ನೇ ನೋಡಬಲ್ಲೆನು."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p04.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಹಹ್ಹಹ್ಹಾ ನಮಗೂ ಇವೆ ಕಣ್ಣುಗಳು, ನಾವೂ ನೋಡಬಲ್ಲೆವು ಅದರಿಂದ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p05.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಪರವಾಗಿಲ್ಲ. ನೋಡಿರಿ ಈಗ, ನನಗಿದೆ ಮೂಗು, ಅದರಿಂದಲೇ ನನ್ನ ಉಸಿರಾಟ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p06.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಅದೇನು ಮಹಾ, ನಮಗೂ ಇವೆ ಮೂಗುಗಳು. ನಿನಗಿಂತಲೂ ಇವೆ ಚೆನ್ನಾಗಿ.",
        "ಉಸಿರಾಟದ ಜೊತೆ ದೂರದ ವಾಸನೆಯನ್ನು ಅರಿಯುವೆವು."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p07.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಆಹ್ಹಾ, ಹೇಗಿವೆ ನನ್ನ ಬಿಳಿ ಹಲ್ಲುಗಳು. ಜಗಿಯಲು, ಕಚ್ಚಲು ನೆರವಾಗುವವು."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p08.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಹಲ್ಲುಗಳೇ, ಹ್ಹಹ್ಹಾ, ನಮ್ಮ ಹಲ್ಲುಗಳನ್ನು ಎಂದಾದರೂ ನೋಡಿದ್ದೀಯಾ?",
        "ನೀನು ಜಗಿಯುವೆ, ನಾವು ಕಚ್ಚಿಯೇ ಬಿಡುವೆವು! ಹ್ಹಿ….ಹ್ಹಿ….ಹ್ಹಿ…."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p09.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಅಷ್ಟೇ ಅಲ್ಲ, ಇನ್ನೊಂದು ಮಾತು ಕೇಳಿ. ನನ್ನ ಕಿವಿಗಳಿಂದ ಎಲ್ಲವನ್ನು ಆಲಿಸಬಲ್ಲೆನು."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p10.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಿನ್ನಂತೆ ಕಿರಿ ಕಿವಿಗಳಲ್ಲ ನಮ್ಮವು. ನಿನಗೆ ಅರಿಯದೆ ಹೋಗುವ",
        "ಸಪ್ಪಳಗಳನ್ನು ಆಲಿಸಬಲ್ಲ ಬಲಶಾಲಿಗಳು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p11.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಿಮಗೇನು ಗೊತ್ತು, ಕಾಲಿವೆ ಎರಡು ನನಗೆ ನಡೆದಾಡುವುದಕ್ಕೆ,",
        "ಓಡಾಡುವುದಕ್ಕೆ, ಕುಣಿಯಲೂ ಕೂಡಾ ಸಾಧ್ಯವಿದೆ."
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p12.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಅಯ್ಯೋ ಬಿಡಮ್ಮಾ, ನಮಗಿವೆ ನೆಗೆದಾಡಲು ನಾಲ್ಕ ಕಾಲುಗಳು. ನಡೆದಾಡುವೆವು, ಎಡ ಬಲ ಮೆರವಣಿಗೆಯನ್ನೂ ನಡೆಸುವೆವು."
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p13.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಎಂತಹ ಕರಿ ಕೂದಲು ನನ್ನದು."
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p14.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಆಹಾ, ನಮಗೂ ಇವೆ ಕೂದಲು. ರಾಶಿ ಬಿಟ್ಟರೂ ಚಂದ, ಜಡೆಗೂ ಅಂದ."
      ]
    },
    {
      "n": 15,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p15.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನೋಡುವಿರಾ, ನನ್ನ ಕೈಗಳು. ಕುಶಲತೆಯಲ್ಲಿ ಮೀರಿಸಲಾರಿರಿ ನೀವು."
      ]
    },
    {
      "n": 16,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p16.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಕೈಗಳೇ! ಪಾಪ ಅವು ನಿನ್ನ ಬಳಿಯೇ ಇರಲಿ!"
      ]
    },
    {
      "n": 17,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p17.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ದೃಶ್ಯ – 2"
      ]
    },
    {
      "n": 18,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p18.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಈಗಲಾದರೂ ಅರಿಯಿತೇ, ನಾನೇ ಹುಷಾರು, ನನಗೆ ಎಲ್ಲವೂ ಗೊತ್ತು!"
      ]
    },
    {
      "n": 19,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p19.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಹೌದೇನು? ನಮ್ಮ ಉಗುರಿನ ಚೂಪು ಗೊತ್ತೇನು ನಿನಗೆ."
      ]
    },
    {
      "n": 20,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p20.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಹೌದು, ನಿಮ್ಮ ಉಗುರಲ್ಲಿ ತುಂಬುವುದು ಕಸ ಕೊಳೆಯೆಲ್ಲಾ,",
        "ಹೊಟ್ಟೆಗದು ಒಳ್ಳೆಯದಲ್ಲಾ."
      ]
    },
    {
      "n": 21,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p21.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಹಾಗಾದರೆ ಕಾಣು, ನಮಗಿರುವ ಆಕರ್ಷಕ ಬಾಲಗಳು."
      ]
    },
    {
      "n": 22,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p22.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಬಾಲ, ನಮಗವು ಬೇಡವೆ ಬೇಡ ಎಂದೇಬಿಟ್ಟವು.",
        "ಧರಿಸುವುದೆಂತು ಚಡ್ಡಿಯನು!"
      ]
    },
    {
      "n": 23,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p23.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಮ್ಮ ಘರ್ಜನೆ ಕೇಳಿದ್ದೀಯಾ, ಬೆಚ್ಚಿ ಬೀಳುವೆ ನೀನು."
      ]
    },
    {
      "n": 24,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p24.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನಮ್ಮಮ್ಮನ ಜೋರಿನ ಕಥೆ ಗೊತ್ತಾ!"
      ]
    },
    {
      "n": 25,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p25.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಅಷ್ಟೇ ನಿಮ್ಮದು! ಎಷ್ಟಾದರೂ ನೀವು ಪ್ರಾಣಿಗಳು – ನನಗದು ಗೊತ್ತು."
      ]
    },
    {
      "n": 26,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p26.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಮಾನವರೂ ಅಷ್ಟೇ, ಪ್ರಾಣಿಗಳು – ಎಂಬುದು ನಮಗೂ ಗೊತ್ತು."
      ]
    },
    {
      "n": 27,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p27.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ನೀವು ಅಂದುದು ನಿಜ. ಇರಬಹುದೇನೋ – ನೋಡಿ ನನ್ನ ತಮ್ಮನನ್ನು. ಅಮ್ಮ ಅಂತಾರೆ ಆತ ಕಾಡಿನಿಂದ ಬಂದವನೆಂದು, ವರ್ತನೆಯಂತೂ ಪ್ರಾಣಿಯದೇ."
      ]
    },
    {
      "n": 28,
      "image": {
        "src": "/data/picturebooks/1114-naavellaru-praanigalu/p28.jpg",
        "width": 708,
        "height": 339
      },
      "text": [
        "ಹೌದು, ನೀನೂ ಅಷ್ಟೇ, ಮತ್ತೊಂದು. ನಮ್ಮನು ನಂಬದೆ ವಿಧಿಯಿಲ್ಲ.",
        "ನಾವೆಲ್ಲರೂ ಪ್ರಾಣಿಗಳು. ಇದುವೇ ಭೂಮಿಯ ಜೀವಿಗಳು."
      ]
    }
  ]
}