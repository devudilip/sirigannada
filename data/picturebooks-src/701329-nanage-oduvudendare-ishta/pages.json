      "n": 4,
      "image": {
        "src": "/data/picturebooks/701329-nanage-oduvudendare-ishta/p04.jpg",
        "width": 1676,
        "height": 1203
      },
      "text": [
        "ಅವುಗಳಲ್ಲಿ ಕೆಲವು ನಿಜಕ್ಕೂ ತಮಾಷೆಯಾಗಿವೆ!",
        "ನೋಡಿ ಒಮ್ಮೆ!"
