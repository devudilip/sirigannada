    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/701329-nanage-oduvudendare-ishta/p05.jpg",
        "width": 1676,
        "height": 1203
      },
      "text": [
        "ಇನಿಕಾ ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ ತನ್ನ ಅಮ್ಮನೊಂದಿಗೆ ಪತ್ರಿಕೆ ಓದುತ್ತಾಳೆ.",
        "ಅವಳಿಗೆ ಪದಗಳನ್ನು ಹಿಂದು ಮುಂದಾಗಿ ಓದಲು ಸಾಧ್ಯವೇ?"
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/701329-nanage-oduvudendare-ishta/p06.jpg",
        "width": 1676,
        "height": 1203
      },
      "text": [
        "ಅವಿಗೆ ಮರದ ಕೆಳಗೆ ಕುಳಿತು ಓದಲು ಇಷ್ಟ.",
        "ಮಳೆ ಬಂದಾಗ ಏನು ಮಾಡುತ್ತಾನೆ?"
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/701329-nanage-oduvudendare-ishta/p07.jpg",
        "width": 1676,
        "height": 1203
      },
      "text": [
        "ತನಯ್‌ಗೆ ತನ್ನ ಮಂಚದ ಕೆಳಗೆ ಮಲಗಿಕೊಂಡು ಓದುವುದೆಂದರೆ ಇಷ್ಟ.",
        "ಕತ್ತಲೆಯಲ್ಲಿ ನೋಡಲು ಅವನಿಗೆ ಬೆಕ್ಕಿನ ಕಣ್ಣುಗಳಿವೆಯೇ?"
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/701329-nanage-oduvudendare-ishta/p08.jpg",
        "width": 1676,
        "height": 1203
      },
      "text": [
        "ಆನ್ಯಾ ತನ್ನ ಬಚ್ಚಲು ಮನೆಯಲ್ಲಿ ಬಹಳ ಬಹಳ ಪುಸ್ತಕಗಳನ್ನು ಇಟ್ಟಿದ್ದಾಳೆ.",
        "ಅದಕ್ಕಾಗಿಯೇ ಅವಳು ಹೊರಬರಲು ತುಂಬಾ ಸಮಯ ತೆಗೆದುಕೊಳ್ಳುತ್ತಾಳೆ."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/701329-nanage-oduvudendare-ishta/p09.jpg",
        "width": 1676,
        "height": 1203
      },
      "text": [
        "ಸಮರ್ ತನ್ನ ಶಾಲಾ ಬಸ್ಸಿನಲ್ಲಿ ಓದುತ್ತಾನೆ.",
        "ಅವನಿಗೆ ಕನ್ನಡಕ ಬೇಗ ಬರಬಹುದೆನೋ?"
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/701329-nanage-oduvudendare-ishta/p10.jpg",
        "width": 1676,
        "height": 1203
      },
      "text": [
        "ಸೀಮಾ ಹೆಚ್ಚು ಹೆಚ್ಚು ಪುಸ್ತಕಗಳನ್ನು ಓದಲು ಗ್ರಂಥಾಲಯಕ್ಕೆ ಹೋಗುತ್ತಾಳೆ.",
        "ಆದರೆ, ಅವಳು ಆಟ ಯಾವಾಗ ಆಡುತ್ತಾಳೆ?"
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/701329-nanage-oduvudendare-ishta/p11.jpg",
        "width": 1676,
        "height": 1203
      },
      "text": [
        "ಚಿಕಿ ಓದುತ್ತಲೇ ತಿನ್ನುತ್ತಾಳೆ, ತಿನ್ನುತ್ತಲೇ ಓದುತ್ತಾಳೆ! ಪುಸ್ತಕಗಳು ಇಲ್ಲದಿದ್ದರೆ ಅವಳು ಊಟ ಮಾಡುವುದನ್ನೇ ನಿಲ್ಲಿಸುತ್ತಾಳಾ?"
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/701329-nanage-oduvudendare-ishta/p12.jpg",
        "width": 1676,
        "height": 1203
      },
      "text": [
        "ಆದರೆ, ನಾನು ಎಲ್ಲಿ ಬೇಕಾದರೂ ಮತ್ತು ಯಾವಾಗ ಬೇಕಾದರೂ ಓದಬಲ್ಲೆ.",
        "...ಹ್ಞಾಂ, ಈಜುವಾಗ ಆಗುವುದಿಲ್ಲ ಮತ್ತೆ."
      ]
