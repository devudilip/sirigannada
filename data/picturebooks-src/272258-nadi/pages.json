      "n": 4,
      "image": {
        "src": "/data/picturebooks/272258-nadi/p04.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನದಿ ಚಲಿಸುವ ನಗರ",
        "ನದಿ ಅನೇಕರ ಮನೆ"
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/272258-nadi/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನಮ್ಮೆಲ್ಲರ ದಾಹ ತಣಿಯುವುದು ನದಿಯಲ್ಲಿ",
        "ಮೀನುಗಳ ಉಸಿರು ಹರಿಯುತ್ತದೆ ನದಿಯಲ್ಲಿ"
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/272258-nadi/p06.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ನದಿ ನೆಗಳೆಗಳ ದಿನದ ಗಡಿಯಾರ",
        "ನದಿಯೋ ಮೋಡಗಳ ನೂಲೋ"
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/272258-nadi/p07.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ನದಿ ಹೊಲಗಳ ಮುಖದ ಕಳೆ",
        "ರೈತರ ನೋಟ ಮೋಡದ ಕಡೆಗೆ"
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/272258-nadi/p08.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ನದಿ ಮಣ್ಣಿನ ಬಣ್ಣ ಬದಲಿಸುತ್ತದೆ",
        "ಮರದಿಂದ ಮರಕ್ಕೆ ನದಿ ಸುರಳಿ"
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/272258-nadi/p09.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನೋಡಿ, ಅಣೆಕಟ್ಟಿನಲ್ಲಿ ಅದರ ಎತ್ತರ",
        "ಮತ್ತು ಹೆಮ್ಮೆಯಿಂದ ನಿಂತಿರುವುದನ್ನ",
        "ನದಿಯೋ ಮೋಡಗಳ ನೂಲೋ"
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/272258-nadi/p10.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ಸೂರ್ಯ ನೀರನ್ನ ತನ್ನೆಡೆಗೆ ಸೆಳೆಯುತ್ತಾನೆ",
        "ಮೀನುಗಾರ ನದಿಯಲ್ಲಿ ಬಲೆ ಹಾಕಿ",
        "ಮೀನುಗಳನ್ನ ತನ್ನೆಡೆಗೆ ಎಳೆವಂತೆ"
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/272258-nadi/p11.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ನೀವು ಎಷ್ಟು ಸಲ ನೋಡಿದ್ದರೂ ಪ್ರತಿ ಸಲವೂ ಹೊಸದಾಗಿಯೇ",
        "ಕಾಣುವುದು ನದಿ"
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/272258-nadi/p12.jpg",
        "width": 708,
        "height": 509
      },
      "text": [
        "ನದಿ ತನ್ನ ಕೈಯಲ್ಲಿ ಹಿಡಿದಿದೆ",
        "ಒಂದು ಮಾಂತ್ರಿಕದಂಡ",
        "ನದಿಯೋ ಮೋಡಗಳ ನೂಲೋ"
      ]
    },
