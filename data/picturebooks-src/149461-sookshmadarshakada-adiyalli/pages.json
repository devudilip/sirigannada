        "ಸೈನೋಬ್ಯಾಕ್ಟೀರಿಯಾಗಳು ನಿಶ್ಚಲವಾಗಿರುತ್ತವೆ... ಸೂಕ್ಷ್ಮದರ್ಶಕದಡಿಯಲ್ಲಿ."
      ]
    },
    {
      "n": 15,
      "image": {
        "src": "/data/picturebooks/149461-sookshmadarshakada-adiyalli/p15.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಸೂಕ್ಷ್ಮ ಜೀವಿಗಳು ಎಲ್ಲೆಲ್ಲೂ ಇವೆ!",
        "ಹೈಡ್ರಾಗಳು ಸಸ್ಯಗಳಂತೆ ಕಾಣುತ್ತವೆ, ಟಾರ್ಡಿಗ್ರೇಡ್‌ಗಳು ಸಣ್ಣ ಕರಡಿಯಂತೆ ನಡೆಯುತ್ತವೆ. ಅಮೀಬಾಗಳು ಆಕಾರ ಬದಲಾಯಿಸುತ್ತವೆ. ಇವೆಲ್ಲ ನಮ್ಮ ಸುತ್ತಮುತ್ತ ವಾಸಿಸುವ ಸೂಕ್ಷ್ಮಜೀವಿಗಳು.",
        "ಭೂಗರ್ಭದಿಂದ ಅಂತರಿಕ್ಷದವರೆಗೂ ಸೂಕ್ಷಜೀವಿಗಳು ಎಲ್ಲೆಲ್ಲೂ ಇವೆ. ಅತಿ ಶೈತ್ಯ, ಅತಿ ಉಷ್ಣ ವಾತಾವರಣದಲ್ಲೂ ಈ ಜೀವಿಗಳು ಜೀವಿಸಬಲ್ಲವು. ಆಹಾರ ಪದಾರ್ಥಗಳು, ಕಸಕಡ್ಡಿಗಳು, ಕಲ್ಲುಬಂಡೆ, ಮಣ್ಣಿನ ಮೇಲೆ ಕೂಡ ವಾಸಿಸುವ ಈ ಸೂಕ್ಷ್ಮಜೀವಿಗಳು ನಮ್ಮ-ನಿಮ್ಮ ಒಳಗೂ ಇರುತ್ತವೆ.",
        "ಹಾಗಾದರೆ ನಮ್ಮ ಸುತ್ತಮುತ್ತ ಎಷ್ಟು ಸೂಕ್ಮಜೀವಿಗಳು ಇರಬಹುದು? ಕೊಳದ ಒಂದು ಹನಿ ನೀರಿನಲ್ಲಿ ಲಕ್ಷಾಂತರ ಸಣ್ಣ ಸೂಕ್ಮಜೀವಿಗಳು ಇರುತ್ತವೆ! ಆದರೆ, ಬರಿಗಣ್ಣಿಗೆ ಕಾಣದ ಅವುಗಳನ್ನು ನೋಡಲು ನಮಗೆ ಸೂಕ್ಷ್ಮದರ್ಶಕದ ಅಗತ್ಯವಿದೆ. ಬರಿಗಣ್ಣಿಗೆ ಕಾಣದ, ಸೂಕ್ಷ್ಮಾತಿ ಸೂಕ್ಷ್ಮ ಜೀವಿಗಳನ್ನು ನಮ್ಮ ಕಣ್ಣಿಗೆ ಕಾಣಿಸುವಷ್ಟು ದೊಡ್ಡದಾಗಿ ತೋರಿಸುವ ಸಾಧನವೇ ಸೂಕ್ಷ್ಮದರ್ಶಕ."
      ]
    },
    {
      "n": 16,
      "image": {
        "src": "/data/picturebooks/149461-sookshmadarshakada-adiyalli/p16.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಇನ್ನಷ್ಟು ತಿಳಿಯೋಣವೇ?!",
        "ಹೈಡ್ರಾಗಳು ಕತ್ತರಿಸಿದ ತಮ್ಮ ದೇಹದ ಭಾಗಗಳನ್ನು ಪುನಃ ಬೆಳೆಸಿಕೊಳ್ಳುತ್ತವೆ. ಇವು ಮುದಿಯಾಗಿ ಸಾಯುವುದೇ ಇಲ್ಲ.",
        "ಪ್ಲಾನೇರಿಯಾಗಳು ಚಪ್ಪಟೆ ಹುಳುಗಳು. ಅವನ್ನು ಇಬ್ಭಾಗ ಮಾಡಿದರೆ ಎರಡು ಭಾಗಗಳೂ ಎರಡು ಬೇರೆ ಬೇರೆ ಪ್ಲಾನೇರಿಯಾಗಳಾಗಿ ಬೆಳೆಯುತ್ತವೆ.",
        "ಯುಗ್ಲೆನಾಗಳು ಗಿಡಮರಗಳಂತೆ, ದ್ಯುತಿಸಂಶ್ಲೇಷಣೆ ಮೂಲಕ ತಮ್ಮ ಆಹಾರವನ್ನು ತಾವೇ ತಯಾರಿಸಿಕೊಳ್ಳಬಲ್ಲವು.",
        "ಡಯಾಟಮ್‌ಗಳು ನಮಗೆ ಉಸಿರಾಡಲು ಅಗತ್ಯವಿರುವ ಆಮ್ಲಜನಕವನ್ನು",
        "ಉತ್ಪತ್ತಿ ಮಾಡುತ್ತವೆ.",
        "ಅಮೀಬಾಗಳು ಆಕಾರವನ್ನು ಬದಲಾಯಿಸುತ್ತವೆ, ಕೆಲವೊಮ್ಮೆ ತಮ್ಮ ಆಹಾರ ಬೇಟೆಯಾಡಲು ಹೀಗೆ ಮಾಡುತ್ತವೆ."
      ]
    },
