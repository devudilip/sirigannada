      "image": {
        "src": "/data/picturebooks/481245-nanna-mane-endare/p10.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನಾಯಿ ಕಾಳ, ಪಕ್ಯಾ ಬಳಗದ ಕಾ ಕಾ,",
        "ಮಾಯಾ ಮತ್ತದರ ಮರಿಗಳು ,",
        "ನಿಮಗೆ ಕೇಳುತ್ತಿದೆಯ?"
