      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/481245-nanna-mane-endare/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ನನ್ನ ಮನೆಯಲ್ಲಿ ಒಮ್ಮೊಮ್ಮೆ",
        "ಸೂಜಿ ಬಿದ್ದರೂ ಸದ್ದಾಗುವುದು,"
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/481245-nanna-mane-endare/p09.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಆದರೆ, ಗದ್ದಲವೇ ಜಾಸ್ತಿ.",
        "ಬೊಗಳುವ, ಗಂಟೆಯ,",
        "ಹಾಡುವ ಸದ್ದು ಕೂಡ!"
      ]
