      "image": {
        "src": "/data/picturebooks/26560-chiyoo-kanda-jaadoo/p05.jpg",
        "width": 639,
        "height": 336
      },
      "text": [
        "ಮನೆಗೆ ಓಡಿ ಹೋದ ಚಿಯು ಅಜ್ಜಿಗೆ ಹೇಳಿದಳು.",
        "“ಅಜ್ಜಿ ಯಾರಿಗೂ ಕಾಣದಿರುವುದು ನನಗಷ್ಟೇ ಕಾಣುತ್ತಲ್ಲ,",
        "ಏನೋ ಜಾದೂ ಇರಬೇಕು!”"
      ]
