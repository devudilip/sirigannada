    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p02.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಕೂರ್… ಕೂರ್... ಕೂ...ರ್",
        "ಹಕ್ಕಿಯ ಧ್ವನಿ ಕೇಳಿ ಅಮ್ಮಿನಿಗೆ ಎಚ್ಚರವಾಯಿತು.",
        "ಕಣ್ಣುಜ್ಜಿಕೊಳ್ಳುತ್ತಾ ಎದ್ದು ನೋಡಿದಳು, ಮಾವಿನ",
        "ಮರದಲ್ಲಿ ರತ್ನಪಕ್ಷಿಯೊಂದು ಗೂಡು ಕಟ್ಟಿಕೊಳ್ಳುತ್ತಿತ್ತು."
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p03.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಅಯ್ಯೋ! ನಿನ್ನೆ ರಾತ್ರಿ ನಾನು ಸಮವಸ್ತ್ರವನ್ನು ತಯಾರು ಮಾಡಿಟ್ಟುಕೊಳ್ಳೋದನ್ನೇ",
        "ಮರೆತುಬಿಟ್ಟೆ. ಓಹ್, ಶಾಲೆಗೆ ಹೋಗಬೇಕಿಲ್ಲ ಅಲ್ವಾ?” ಅಮ್ಮಿನಿ ಗೊಣಗಿಕೊಂಡಳು.",
        "ಅಡುಗೆ ಮನೆಯಲ್ಲಿ ಅಪ್ಪ ಕಾಫಿ, ಇಡ್ಲಿ ತಯಾರು ಮಾಡುತ್ತಿದ್ದರು. ಅಮ್ಮಿನಿ ಓಡಿ ಬಂದು",
        "ಅಪ್ಪನನ್ನು ತಬ್ಬಿಕೊಳ್ಳುತ್ತ ಶುಭಮುಂಜಾವು ಎಂದಳು. ಈವತ್ತಾದರೂ ಮನೆಯವರೆಲ್ಲ",
        "ಸೇರಿ ಆಚೆ ತಿರುಗಾಡಲು ಹೋಗುವ ಹಾಗಾಗಲಿ ಎಂದು ಅವಳ ಹಂಬಲಿಸುತ್ತಿದ್ದಳು."
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p04.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಮ್ಮಿನಿ, “ಇಡ್ಲಿ ತುಂಬಾ ಚೆನ್ನಾಗಿವೆ, ಅಪ್ಪ!”",
        "ನಾಲ್ಕು ವರ್ಷದ ಅವಳ ತಮ್ಮ ಉನ್ನಿ ನಿದ್ದೆಗಣ್ಣಿನಲ್ಲಿ",
        "“ಕಮಲಾ ಚಿಕ್ಕಿ?” ಎಂದು ಕೂಗುತ್ತ ಅಡುಗೆ ಮನೆಗೆ ಬಂದ.",
        "ಅಮ್ಮಿನಿ ಮತ್ತು ಉನ್ನಿಗೆ ಕಮಲಾ ಚಿಕ್ಕಿಯೊಂದಿಗೆ ಆಟವಾಡುವುದು ತುಂಬಾ ಇಷ್ಟ."
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p05.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಪ್ಪ, “ಅವಳಿನ್ನೂ ಆಸ್ಪತ್ರೆಯಲ್ಲಿದ್ದಾಳೆ, ಉನ್ನಿ.",
        "ಅಲ್ಲಿರೋ ರೋಗಿಗಳಿಗೆ ಹುಷಾರಾದ ತಕ್ಷಣ ಮನೆಗೆ ಬರುತ್ತಾಳೆ.”",
        "ಉನ್ನಿಯ ಮುಖ ಬಾಡಿತು. ಕಮಲಾ ಚಿಕ್ಕಮ್ಮ ನರ್ಸ್ ಆಗಿದ್ದಾರೆ. ವಾರದಿಂದ ಮನೆಗೆ ಬಂದಿಲ್ಲ."
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p06.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಮ್ಮಿನಿ, “ಉನ್ನಿ, ನೋಡು ಬಾ. ನಮ್ಮ",
        "ಕೈತೋಟದಲ್ಲಿ ಎಷ್ಟೊಂದು ಹೂ ಅರಳಿವೆ.”"
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p07.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಅಲ್ನೋಡು, ಕಣಗಿಲೆ ಹೂ. ಅಲ್ಲಿ ನಡುವೆ ಹಳದಿ ಕಂಡಿತಾ?",
        "ಜೇನುಹುಳುಗಳು ಮಕರಂದ ಹೀರಿ ಹೋಗಲು ಬರ್ತಿವೆ.",
        "ಆ ಕಿಸುಕಾರೆ ಹೂವಿನ ದೊಡ್ಡ ಗೊಂಚಲು ಕಂಡಿತಾ?",
        "ಇಂಗ್ಲಿಷಿನಲ್ಲಿ ಜಂಗಲ್ ಫ್ಲೇಮ್ ಅಂತೆ ಟೀಚರ್ ಹೇಳ್ತಿದ್ರು. ”"
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p08.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "“ಹಲ್ಲೋ!”",
        "ಅಮ್ಮಿನಿ, “ಅಬು ಅಂಕಲ್! ನಿಮ್ಮ ಮಾಸ್ಕ್ ಇಷ್ಟ ಆಯ್ತು.”",
        "ಅಬು ಅಂಕಲ್ ಹಾಯ್ ಮಾಡುತ್ತ ಕೇಳಿದರು,",
        "“ನೀವಿಬ್ರೂ ಏನ್ ಮಾಡ್ತಿದೀರಿ ಇಲ್ಲಿ?”",
        "ಅಮ್ಮಿನಿ, “ಹೂಗಳನ್ನ ನೋಡ್ತಾ ಇದ್ವಿ.",
        "ಎಲ್ಲಿ ನಿಮ್ಮ ಪೊಲೀಸ್ ಕಾರ್?”"
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p09.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಬು ಅಂಕಲ್, “ಇನ್ನೂ ಮಲಗಿದೆ.",
        "ರಾತ್ರಿಯಿಡೀ ಸೈರನ್ ಕೂಗ್ತಾ ಸುತ್ತಾಡ್ತಾನೇ",
        "ಇತ್ತಲ್ಲ. ಮನೆಯಲ್ಲೇ ಇರಿ. ಇಲ್ಲ ಅಂದ್ರೆ ಅದು",
        "ಎದ್ದು ಬಂದು, ವ್ಯಾಂವ್ಯಾಂಯಾಂ,” ಅಂತ",
        "ಕೂಗತ್ತೆ. ಎನ್ನುತ್ತ ಮಕ್ಕಳಿಗೆ ಟಾಟಾ ಹೇಳುತ್ತ",
        "ಅವರಮ್ಮ ಜೀನತ್ ಆಂಟಿ ಮನೆಯ ಕಡೆಗೆ",
        "ಹೋದರು.",
        "ಇನ್ನೇನು ಈದ್ ಹಬ್ಬ ಬಂತಲ್ವ. ಪ್ರತೀ ವರ್ಷ,",
        "ಜೀನತ್ ಆಂಟಿ ರುಚಿ-ರುಚಿಯಾದ",
        "ಬಿರಿಯಾನಿ ಮತ್ತು ಶೀರ್ ಕೂರ್ಮಾ ಮಾಡ್ತಾ",
        "ಇದ್ರು. ಈ ವರ್ಷ ಹಬ್ಬಕ್ಕೆ ಅವರ ಮನೆಗೆ",
        "ಹೋಗಲು ಆಗತ್ತೋ ಇಲ್ಲವೋ ಎಂದು",
        "ಅಮ್ಮಿನಿಗೆ ಚಿಂತೆಯಾಯಿತು."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p10.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಮ್ಮ, “ಅಮ್ಮಿನಿ, ಶಾಲೆ ಹೊತ್ತಾಯ್ತು.”",
        "“ಗುಡ್ ಮಾರ್ನಿಂಗ್, ಮಾಯಾ ಟೀಚರ್!”",
        "ಅಮ್ಮಿನಿಯ ಸಹಪಾಠಿಗಳೆಲ್ಲ ಲ್ಯಾಪ್ ಟಾಪಿನ",
        "ಚೌಕು ಕಿಂಡಿಯೊಳಗೆ ಒಬ್ಬರಿಗೊಬ್ಬರು ಹಾಯ್ ಎಂದರು.",
        "ಆಗ ಶಾಲೆ ಬೇರೆ ರೀತಿ ಇದೆ. ಅಮ್ಮಿನಿಯ ಗೆಳತಿ",
        "ನಿನಾ ಇಂದು ಬಂದಿರಲಿಲ್ಲ. ಅವಳು ವಾರಕ್ಕೆ",
        "ಎರಡು ದಿನ ಮಾತ್ರ ಹಾಜರಾಗುತ್ತಿದ್ದಳು.",
        "ಏಕೆಂದರೆ, ಇರುವ ಒಂದು ಕಂಪ್ಯೂಟರಿನಲ್ಲೇ",
        "ಅವಳು ಮತ್ತು ಅವಳಣ್ಣ ಕ್ಲಾಸ್ ಕೇಳಬೇಕಿತ್ತು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p11.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಮ್ಮಿನಿ ನಿನಾಳನ್ನು ತುಂಬಾ ನೆನೆಪಿಸಿಕೊಳ್ಳುತ್ತಿದ್ದಳು.",
        "ಅದಕ್ಕಿಂತ ಹೆಚ್ಚಾಗಿ ಶಾಲೆಯನ್ನು. ಗಿಗಿ ಅಣ್ಣನ ರಿಕ್ಷಾದಲ್ಲಿ",
        "ಉಬ್ಬು-ತಗ್ಗು ರೋಡುಗಳ ಮೇಲೆ ಶಾಲೆಗೆ ಹೋಗ್ತಾ",
        "ಇದ್ದಿದ್ದು. ನಿನಾ ಜೊತೆ ಆಟದ ಮೈದಾನದ ಕೆಸರಿನಲ್ಲಿ",
        "ಪಚಕ್ ಪಚಕ್ ಜಿಗಿಯುತ್ತ ಆಡುತ್ತಿದ್ದ ಆಟ. ಊಟದ",
        "ಸಮಯದಲ್ಲಿ ಗೆಳತಿಯರೊಂದಿಗೆ ಪಿಸುಗುಡುತ್ತ ತಿಂಡಿ",
        "ಡಬ್ಬಗಳ ಅದಲು-ಬದಲು. ಅವಳಿಷ್ಟದ ಕಲರ್ ಪೆನ್ಸಿಲ್ಸ್ ಡಬ್ಬ ಇನ್ನೂ ಶಾಲೆಯಲ್ಲಿಯೇ ಇದೆ. ಅವಳಿಗದು ಇನ್ನು ಯಾವಾಗ ಸಿಗುತ್ತೋ?"
      ]
    },
    {
      "n": 12,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p12.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಊಟದ ಸಮಯಕ್ಕೆ ಶಾಲೆ ಮುಗಿಯಿತು.",
        "ಉನ್ನಿ, “ಅಕ್ಕಾ, ಆಟ ಆಡಲು ಗ್ರೌಂಡಿಗೆ",
        "ಹೊಗೋಣ್ವಾ?”",
        "ಅಮ್ಮಿನಿ ಅಮ್ಮನತ್ತ ನೋಡಿದಳು.",
        "ಅಮ್ಮ ಬೇಡ ಎಂದು ತಲೆಯಾಡಿಸಿದಳು.",
        "ಅಮ್ಮಿನಿ, “ಇವತ್ತು ಬೇಡ, ಉನ್ನಿ. ಆದ್ರೆ ನಾವು",
        "ಮನೆಯಲ್ಲೇ ಆಡೋಣ. ಅದೇ ಆವತ್ತು ಅಮ್ಮ",
        "ತೋರಿಸಿದ್ರಲ್ಲ ಆ ಆಟ. ವೊಲ್ಕಾನೋ ಲಾವಾ!”",
        "ಆಡೋಣ್ವಾ? ಅಮ್ಮಿನಿ ತಮ್ಮನನ್ನು ಕೇಳಿದಳು."
      ]
    },
    {
      "n": 13,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p13.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಮ್ಮಿನಿ ಮತ್ತು ಉನ್ನಿ ಮನೆತುಂಬ ಓಡಾಡಿ ದಿಂಬು, ಕುಶನ್,",
        "ಹೊದಿಕೆಗಳನ್ನು ಕೂಡಿಟ್ಟರು. ತಾವು ಆಡುತ್ತಿದ್ದ ಪ್ರಾಣಿಗಳ",
        "ಗೊಂಬೆಗಳನ್ನು ತಂದು ಕೋಣೆಯಲ್ಲಿ ಜೋಡಿಸಿಟ್ಟರು.",
        "“ಬಾ ಉನ್ನಿ, ನಾವೀಗ ಪ್ರಾಣಿಗಳನ್ನು ರಕ್ಷಿಸಬೇಕು.",
        "ಆದ್ರೆ, ಈ ನೆಲ ಲಾವಾ ಅನ್ನೋದು ನೆನಪಿರಲಿ!”"
      ]
    },
    {
      "n": 14,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p14.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಮ್ಮಿನಿ, “ಆಟ ಏನ್ ಮಜವಾಗಿತ್ತು ಅಲ್ವ!” ಎಂದಳು.",
        "ಇಬ್ಬರೂ ಆಟಿಕೆಗಳೊಂದಿಗೆ ಹಾಸಿಗೆಯ ಮೇಲೆ ಮಲಗಿದರು.",
        "“ಹೌದು, ಆದರೆ ನನಗೆ ಜಾರುಬಂಡಿ, ಜೋಕಾಲಿ,",
        "ಹುಲ್ಲು ತುಂಬಾ ನೆನಪಾಗುತ್ತಿವೆ, ಅಕ್ಕ.”"
      ]
    },
    {
      "n": 15,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p15.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಅಮ್ಮಿನಿ, “ನನಗೂ ಬೀಚಿಗೆ ಹೋಗ್ತಾ ಇದ್ದಿದ್ದು,",
        "ಕಾಟನ್ ಕ್ಯಾಂಡಿಗಳು, ಬಲೂನುಗಳು,",
        "ಅಜ್ಜ-ಅಜ್ಜಿಯ ಮನೆ ಎಲ್ಲ ನೆನಪಾಗ್ತಿವೆ.”",
        "ಇಬ್ಬರೂ ಹೊರಗೆ ತಿರುಗಾಡಲು ಹೋದ ಹಾಗೆ,",
        "ಮೈದಾನದಲ್ಲಿ ಓಡಿದ ಹಾಗೆ, ಅಜ್ಜ-ಅಜ್ಜಿಯನ್ನು",
        "ಗಟ್ಟಿಯಾಗಿ ಅಪ್ಪಿಕೊಂಡಂತೆ ಊಹಿಸಿಕೊಂಡರು."
      ]
    },
    {
      "n": 16,
      "image": {
        "src": "/data/picturebooks/275989-maneye-maidanavaadaaga/p16.jpg",
        "width": 708,
        "height": 508
      },
      "text": [
        "ಹೊರಗೆ ಸೂರ್ಯ ಕೇಸರಿ ಬಣ್ಣದ ಗೋಲಿಯಂತೆ ಕಾಣುತ್ತಿದ್ದಾನೆ.",
        "ಅಮ್ಮಿನಿ, “ಒಂದು ಸುತ್ತು ತಿರುಗಾಡಲು ಹೋಗುವ ಹಾಗಿದ್ದಿದ್ದರೆ,",
        "ಕೊನೆಯ ಸಲ ಶೂ ಹಾಕಿದ್ದು ಯಾವತ್ತು ಅನ್ನೋದು ಕೂಡ ಮರೆತಿದೆ.”",
        "ಅಮ್ಮ-ಅಪ್ಪ ಸಂಗೀತ ಕೇಳುತ್ತ ಸೋಫಾ ಮೇಲೆ ಕುಳಿತಿದ್ದಾರೆ.",
        "ಅಮ್ಮಿನಿ ಉನ್ನಿಯ ಕೈ ಹಿಡಿದುಕೊಂಡಳು. ಇಬ್ಬರೂ ಓಡಿ ಹೋಗಿ,",
        "ಅಪ್ಪ-ಅಮ್ಮನ ನಡುವೆ ತೂರಿ, ಆತುಕೊಂಡು ಕುಳಿತರು.",
        "ಅಮ್ಮಿನಿ ಅಂದುಕೊಂಡಳು, “ಆದಷ್ಟು ಬೇಗ ನಾವು ಹೊರಗೆ ತಿರುಗಾಡಲು",
        "ಅಥವಾ ಬೀಚಿಗೆ ಹೋಗುವಂತಾಗಬಹುದು. ಅಲ್ಲಿಯವರೆಗೆ ನಾನು, ಉನ್ನಿ",
        "ಮತ್ತು ಅಮ್ಮ-ಅಪ್ಪನೊಂದಿಗೆ ಖುಷಿಯಾಗಿ ಕಾಲ ಕಳೆಯುತ್ತೇನೆ,” ಎಂದು."
      ]
    }
  ]
}