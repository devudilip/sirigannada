{
  "pages": [
    {
      "n": 1,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p01.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಮೋಡವು ಆಕಾಶದಲ್ಲಿ ಉಲ್ಲಾಸದಿಂದ ಚಲಿಸುತ್ತಿತ್ತು."
      ]
    },
    {
      "n": 2,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p02.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ನವಿಲು ಕೇಳಿತು, \"ನೀನು ಮಳೆ ಸುರಿಸು. ನಿನಗಾಗಿ ನರ್ತಿಸುವೆ. \""
      ]
    },
    {
      "n": 3,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p03.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಮೀನು ಹೇಳಿತು, \"ದಯಮಾಡಿ ಮಳೆ ಸುರಿಸು, ನನಗೆ ಇನ್ನೂ ಹೆಚ್ಚು ನೀರು",
        "ಬೇಕು. \""
      ]
    },
    {
      "n": 4,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p04.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ರೈತ ಹೇಳಿದ, \"ದಯಮಾಡಿ ಮಳೆ ಸುರಿಸು. ಮುಂದಿನ ಬೆಳೆಗಾಗಿ ನಾನು ಬೀಜಗಳನ್ನು ಬಿತ್ತುವೆ. \""
      ]
    },
    {
      "n": 5,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p05.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ರಾಜು ಹೇಳಿದ, \"ನೀನು ಮಳೆಗೈದರೆ, ನಾನು ಕಾಗದದ ದೋಣಿಗಳನ್ನು ತೇಲಿ ಬಿಡುತ್ತೇನೆ.\""
      ]
    },
    {
      "n": 6,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p06.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಆಗ ಮೋಡವು ಪಟ ಪಟ ಹನಿಗಳನ್ನು ಸುರಿಸಿತು."
      ]
    },
    {
      "n": 7,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p07.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ನವಿಲು ತನ್ನ ಸುಂದರ ಗರಿಗಳನ್ನು ಹರಡಿ ನಾಜೂಕಾಗಿ ಹೆಜ್ಜೆಯಿಟ್ಟು ನರ್ತಿಸಿತು."
      ]
    },
    {
      "n": 8,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p08.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಕೊಳ ತುಂಬಿ ಬಂತು. ಮೀನು ಖುಷಿಗೊಂಡಿತು."
      ]
    },
    {
      "n": 9,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p09.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ರೈತನು ನಾಟಿ ಕೆಲಸದಲ್ಲಿ ತೊಡಗಿದನು."
      ]
    },
    {
      "n": 10,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p10.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಜೊಳ್! ಜುಳ್! ಜುಳುಕ್! ರಾಜು ಮತ್ತವನ ಗೆಳೆಯರು ನೀರು ತುಂಬಿದ ಹಳ್ಳಕೊಳ್ಳಗಳಲ್ಲಿ ಕುಣಿದು ಕುಪ್ಪಳಿಸಿ ಮಜವಾಗಿ ಸಮಯ ಕಳೆದರು."
      ]
    },
    {
      "n": 11,
      "image": {
        "src": "/data/picturebooks/697-maleraya/p11.jpg",
        "width": 708,
        "height": 381
      },
      "text": [
        "ಮೋಡವು ಎಲ್ಲರ ಹೃದಯದಲ್ಲೂ ಹರ್ಷ ತುಂಬಿತು. ಅದು ಮುಂದೆ ಮುಂದೆ ಸಾಗಿತು. ಎಲ್ಲ ಮಕ್ಕಳೂ ಆ ಮೋಡಕ್ಕೆ ಶುಭ ವಿದಾಯ ಹೇಳಿದರು."
      ]
    }
  ]
}